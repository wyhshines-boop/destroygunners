---
import ContentBox from './ContentBox.astro';
import DownloadButton from './DownloadButton.astro';
import borderImg from '../img/border.webp';
import buttonImg from '../img/button.webp';
import { type Lang, t } from '../i18n/translations';
import Giscus from './Giscus.astro';

import ScreenshotGallery from './ScreenshotGallery.astro';
import mainlandDownloads from '../data/mainland-downloads.json';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// Bind mirrors to both the selected release URL and exact APK bytes.
const mainlandLinks: Record<string, string> = {};
for (const entry of mainlandDownloads as Array<{ apk: string; url: string; sha256: string }>) {
	const file = resolve(process.cwd(), `public${entry.apk.split('?')[0]}`);
	const digest = createHash('sha256').update(readFileSync(file)).digest('hex');
	if (digest === entry.sha256) mainlandLinks[entry.apk] = entry.url;
}

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const scareSoulHref = lang === 'en' ? '/scaresoul' : `/${lang}/scaresoul`;
const pageHeading = {
	en: 'Destroy Gunners ZZ APK Download & Community',
	zh: '毁灭枪手 Destroy Gunners ZZ 下载与社区',
	ja: 'Destroy Gunners ZZ ダウンロードとコミュニティ',
}[lang];
const scareSoulCopy = {
	en: {
		title: 'ScareSoul',
		subtitle: 'Offline Cracked Edition',
		action: 'Open',
	},
	zh: {
		title: 'ScareSoul',
		subtitle: '离线破解版',
		action: '进入',
	},
	ja: {
		title: 'ScareSoul',
		subtitle: 'オフライン改造版',
		action: 'Open',
	},
}[lang];
const languageGuideCopy = {
 zh: { title: '如何切换游戏语言', log: '更新日志', settings: '在大厅点击右下角的“设置”。', language: '找到“语言”，点击可切换简体中文、English 和 日本語。', restart: '退出设置后选择立即重启，新的语言会在重启后生效。' },
 en: { title: 'How to change the game language', log: 'Release notes', settings: 'In the lobby, tap Settings (设置) at the bottom right.', language: 'Find Language (语言) and tap to cycle through 简体中文, English and 日本語.', restart: 'Close Settings and choose Restart. The selected language takes effect after restarting.' },
 ja: { title: 'ゲームの言語を切り替える', log: '更新履歴', settings: 'ロビー右下の設定（设置）をタップします。', language: '言語（语言）をタップすると、简体中文・English・日本語を切り替えられます。', restart: '設定を閉じて再起動を選ぶと、選択した言語が反映されます。' },
}[lang];
const faqCopy = {
 zh: {
  title: 'FAQ · 常见问题', protect: '被 Google Play 保护机制拦截，如何安装？',
  intro: '请从本站下载，并先按提示完成 Google Play 保护机制扫描。确认来源后，若仍决定继续安装：',
  steps: ['若提示“不允许安装未知应用”，进入系统设置，为本次使用的浏览器或文件管理器开启“允许此来源”。', '若警告窗口提供“更多详情 → 仍要安装”，可从该入口继续。并非所有警告都有此选项。', '如需临时关闭扫描：打开 Play 商店 → 头像 → Play 保护机制 → 右上角设置 → 关闭“使用 Play 保护机制扫描应用”。安装完成后重新开启。'],
  compatibility: '系统提示不兼容或目标SDK过低怎么办？',
  compatibilityBody: '这是系统版本或处理器兼容问题，关闭 Play 保护机制无法解决。游戏目前使用32位原生引擎；部分新系统会限制安装旧SDK应用，纯64位系统也无法直接运行。新版系统兼容包仍在测试中。'
 },
 en: {
  title: 'FAQ', protect: 'How do I install if Google Play Protect blocks the APK?',
  intro: 'Download from this website and run the recommended Play Protect scan first. If you trust the source and decide to proceed:',
  steps: ['If Android blocks unknown apps, allow installation from the browser or file manager you are using in system settings.', 'If the warning offers More details → Install anyway, you can continue there. This option is not available for every warning.', 'To temporarily disable scanning: Play Store → profile icon → Play Protect → Settings → turn off Scan apps with Play Protect. Turn it back on after installation.'],
  compatibility: 'What if the system installer reports incompatibility or a target SDK that is too low?',
  compatibilityBody: 'This is an OS or processor compatibility issue; disabling Play Protect does not fix it. The game uses a 32-bit native engine. Some newer systems restrict old-target apps, and 64-bit-only systems cannot run it directly. A newer-Android compatibility package is still being tested.'
 },
 ja: {
  title: 'FAQ · よくある質問', protect: 'Google Play プロテクトでブロックされた場合は？',
  intro: '当サイトからダウンロードし、まず推奨されたスキャンを実行してください。入手元を確認したうえでインストールを続ける場合：',
  steps: ['不明なアプリのインストールが拒否された場合は、端末の設定で使用中のブラウザやファイル管理アプリにインストールを許可します。', '警告に「詳細 → インストールする」などの選択肢があれば、そこから続行できます。すべての警告に表示されるわけではありません。', '一時的にスキャンを無効にする場合：Play ストア → プロフィール → Play プロテクト → 設定 → アプリのスキャンをオフ。インストール後はオンに戻してください。'],
  compatibility: 'システムが互換性や対象SDKの低さを理由にインストールを拒否する場合は？',
  compatibilityBody: 'OSやプロセッサの互換性の問題で、Play プロテクトをオフにしても解決しません。本作は32ビットのネイティブエンジンを使用しています。新しいOSでは古い対象SDKのアプリが制限され、64ビット専用環境でも直接実行できません。互換性テスト版は現在検証中です。'
 },
}[lang];
const versionCopy = {
 zh: { community: '社区服', offline: '离线版本', intro: '原版停服多年。为让玩家继续体验这款游戏，制作并分享了这些离线版本。', cx: '全机甲解锁版，基于3.0.0b。', b: '离线版。', bx: '离线全机甲解锁版。', a: '早期离线版。' },
 en: { community: 'Community Server', offline: 'Offline Versions', intro: 'The original service ended years ago. These offline versions were made so players can continue enjoying the game.', cx: 'All-mecha unlock edition, based on 3.0.0b.', b: 'Offline edition.', bx: 'Offline edition with all mechs unlocked.', a: 'Earlier offline edition.' },
 ja: { community: 'コミュニティ版', offline: 'オフライン版', intro: '原作のサービス終了後も遊べるように、これらのオフライン版を制作・公開しています。', cx: '3.0.0bをベースにした全機体解放版。', b: 'オフライン版。', bx: '全機体解放オフライン版。', a: '初期のオフライン版。' },
}[lang];
const communityVersion = tr.notifications.versions[0];
const offlineVersions = tr.notifications.versions.slice(1);
const communityUpdateCopy = {
 en: { kicker: 'Community Server', title: '3.0.0c is available', description: 'A private server edition with account registration, cloud saves, friend support and PvP against other players. New accounts start with 2,000 coins, with events held regularly. Supports Chinese, English and Japanese.', imageAlt: 'Destroy Gunners ZZ community server hangar' },
 zh: { kicker: '社区服', title: '3.0.0c 已发布', description: '这是一个私服版本，可注册账户并同步存档、添加好友助战，与其他玩家进行 PvP 对战。新账户初始 2000 金币，并会定期推出活动。游戏支持中文、英文和日语。', imageAlt: 'Destroy Gunners ZZ 社区服大厅' },
 ja: { kicker: 'コミュニティ版', title: '3.0.0c 公開', description: 'プライベートサーバー版です。アカウント登録とセーブ同期、フレンドの僚機支援、他のプレイヤーとのPvPに対応。新規アカウントは2,000コインで開始し、イベントも定期的に開催します。中国語・英語・日本語に対応。', imageAlt: 'Destroy Gunners ZZ コミュニティ版のハンガー' },
}[lang];
---

<div class="container">
	<main>
		<h1 class="visually-hidden">{pageHeading}</h1>


		<ContentBox title={versionCopy.community}>
			<article class="community-update-card">
				<ScreenshotGallery lang={lang} hero />
				<div class="community-update-copy">
					<span>{communityUpdateCopy.kicker}</span>
					<strong>{communityUpdateCopy.title}</strong>
					<p>{communityUpdateCopy.description}</p>
					<DownloadButton id="open-download" version={communityVersion} text={tr.download.button} mainland={mainlandLinks[communityVersion.apk]} />
				</div>
			</article>
			<details class="release-log">
				<summary><span>{languageGuideCopy.log}</span><span>{communityVersion.sections[0].title}</span></summary>
				<div class="release-log-content">{communityVersion.sections.map((section,index) => (
					<div class="notification-item">{index > 0 && <h3 class="cyan-text">{section.title}</h3>}<ul>{section.items.map(item => <li>{item}</li>)}</ul></div>
				))}</div>
			</details>


		</ContentBox>
		<ContentBox title={versionCopy.offline}>
			<p class="offline-intro">{versionCopy.intro}</p>
			<div class="offline-versions">
				{offlineVersions.map(v => <article class="offline-version">
					<h3>{v.label.replace(/^v/,'')}</h3>
					<p>{versionCopy[v.id as 'cx' | 'b' | 'bx' | 'a']}</p>
					<DownloadButton version={v} text={tr.download.button} mainland={mainlandLinks[v.apk]} />
					<details class="release-log">
						<summary>{languageGuideCopy.log}</summary>
						<div class="release-log-content">{v.sections.map(section => <div class="notification-item"><h4 class="cyan-text">{section.title}</h4><ul>{section.items.map(item => <li>{item}</li>)}</ul></div>)}</div>
					</details>
				</article>)}
			</div>
		</ContentBox>

		<ContentBox title={faqCopy.title}>
			<div class="faq-list">
				<details class="faq-item">
					<summary id="language-guide-title">{languageGuideCopy.title}</summary>
			<div class="language-guide">
				<ol>
					<li><p>{languageGuideCopy.settings}</p><img src="/community/guide/settings.webp" alt={languageGuideCopy.settings} width="1100" height="495" loading="lazy" decoding="async" /></li>
					<li><p>{languageGuideCopy.language}</p><img src="/community/guide/language.webp" alt={languageGuideCopy.language} width="1100" height="495" loading="lazy" decoding="async" /></li>
					<li class="restart-step">{languageGuideCopy.restart}</li>
				</ol>
			</div>
				</details>
				<details class="faq-item">
					<summary>{faqCopy.protect}</summary>
					<div class="faq-body">
						<p>{faqCopy.intro}</p>
						<ol>{faqCopy.steps.map(step => <li>{step}</li>)}</ol>
					</div>
				</details>
				<details class="faq-item">
					<summary>{faqCopy.compatibility}</summary>
					<div class="faq-body"><p>{faqCopy.compatibilityBody}</p></div>
				</details>
			</div>
		</ContentBox>

		<a class="scaresoul-card" href={scareSoulHref}>
			<img src="/scaresoul/ss_logo.webp" alt="ScareSoul" />
			<div class="scaresoul-card-copy">
				<strong>{scareSoulCopy.title}</strong>
				<span>{scareSoulCopy.subtitle}</span>
			</div>
			<span class="scaresoul-card-action">{scareSoulCopy.action}</span>
		</a>

		<ContentBox title={tr.about.title}>
			<p>{tr.about.description}</p>
			<p>{tr.about.contact} <a href="mailto:wyhshines@gmail.com">wyhshines@gmail.com</a></p>
		</ContentBox>
	</main>

	<Giscus lang={lang} />

	<footer class="site-footer">
		<p>{tr.footer}</p>
	</footer>
</div>

<!-- Download Modal -->
<div id="download-modal" class="modal-overlay">
	<div class="modal-box" style={`--border-img: url('${borderImg.src}');`}>
		<h2 class="modal-title">{tr.download.title}</h2>
		<div class="modal-content">
			<a
				id="modal-download-direct"
				href={tr.notifications.versions[0].apk}
				download
				class="retro-btn download-track"
				data-method="direct"
				style={`background-image: url('${buttonImg.src}');`}
			>
				<span class="btn-inner">{tr.download.direct}</span>
			</a>
			<a
				id="modal-download-mainland"
				href={mainlandLinks[tr.notifications.versions[0].apk]}
				hidden={!mainlandLinks[tr.notifications.versions[0].apk]}
				target="_blank"
				rel="noopener"
				class="retro-btn download-track"
				data-method="123_direct"
				style={`background-image: url('${buttonImg.src}');`}
			>
				<span class="btn-inner">{tr.download.mainland}</span>
			</a>
			<div id="mainland-progress" hidden>
				<p role="status" aria-live="polite"></p>
				<progress aria-label={tr.download.mainland}></progress>
				<div class="download-actions"><button type="button"></button><a hidden></a></div>
			</div>
			<div id="mirror-links" class="mirror-links">
				<a
					id="modal-download-google"
					href="#"
					target="_blank"
					rel="noopener"
					class="retro-btn download-track"
					data-method="google_drive"
					style={`background-image: url('${buttonImg.src}');`}
				>
					<span class="btn-inner">{tr.download.googleDrive}</span>
				</a>
				<a
					id="modal-download-lanzou"
					href="#"
					target="_blank"
					rel="noopener"
					class="retro-btn download-track"
					data-method="lanzou_cloud"
					style={`background-image: url('${buttonImg.src}');`}
				>
					<span class="btn-inner" id="lanzou-btn-text">
						{tr.download.lanzou}
					</span>
				</a>
			</div>
		</div>
		<button id="close-download" class="close-btn">&times;</button>
	</div>
</div>

<script>
	import { initMainlandDownload } from '../scripts/mainland-download';
	const sfxOpen = new Audio('/audio/button1.ogg');
	const sfxClose = new Audio('/audio/button2.ogg');

	function playSound(audio: HTMLAudioElement) {
		audio.currentTime = 0;
		audio.play().catch(() => {});
	}


	function initModal() {
		const openBtns = document.querySelectorAll<HTMLButtonElement>(".open-download");
		const modal = document.getElementById("download-modal");
		const closeBtn = document.getElementById("close-download");
		const modalBox = modal?.querySelector(".modal-box");
		
		const modalDirectLink = document.getElementById('modal-download-direct') as HTMLAnchorElement;
		const mirrorLinks = document.getElementById('mirror-links');

		if (!openBtns.length || !modal) return;

		function closeModal() {
			playSound(sfxClose);
			modal!.classList.add("closing");
			modal!.classList.remove("active");
			modalBox?.addEventListener(
				"transitionend",
				() => {
					modal!.classList.remove("closing");
				},
				{ once: true },
			);
		}

		openBtns.forEach(openBtn => openBtn.addEventListener("click", () => {
			playSound(sfxOpen);
			
			const { apk, mainland, hasMirror, googleDrive, lanzou, lanzouPw, version, downloadLabel } = openBtn.dataset;
			modal.dispatchEvent(new Event('download-selection-change'));
			const title = modal.querySelector('.modal-title');
			if (title) title.textContent = `${downloadLabel || ''} ${version || ''}`.trim();

			// Update modal content based on current version data from button
			if (modalDirectLink) {
				modalDirectLink.href = apk || '';
			}
			
			const mainlandLink = document.getElementById('modal-download-mainland') as HTMLAnchorElement;
			if (mainlandLink) {
				mainlandLink.hidden = !mainland;
				if (mainland) mainlandLink.href = mainland;
				else mainlandLink.removeAttribute('href');
			}

			if (mirrorLinks) {
				mirrorLinks.style.display = hasMirror === 'true' ? 'block' : 'none';
				
				const googleLink = document.getElementById('modal-download-google') as HTMLAnchorElement;
				const lanzouLink = document.getElementById('modal-download-lanzou') as HTMLAnchorElement;
				const lanzouText = document.getElementById('lanzou-btn-text');

				if (googleLink) googleLink.href = googleDrive || '#';
				if (lanzouLink) lanzouLink.href = lanzou || '#';
				if (lanzouText) {
					const lang = document.documentElement.lang || 'en';
					// Simple hack to get labels without full i18n object in client script
					const pwLabel = lang === 'zh' ? '密码' : (lang === 'ja' ? 'パスワード' : 'Password');
					const lanzouLabel = lang === 'zh' ? '蓝奏云' : (lang === 'ja' ? 'Lanzou Cloud' : 'Lanzou Cloud');
					lanzouText.textContent = `${lanzouLabel} (${pwLabel}: ${lanzouPw})`;
				}
			}

			modal.classList.remove("closing");
			modal.classList.add("active");
		}));

		closeBtn?.addEventListener("click", closeModal);

		modal.addEventListener("click", (e) => {
			if (e.target === modal) closeModal();
		});
	}

	function initDownloadTracking() {
		document.querySelectorAll('.download-track').forEach(btn => {
			if ((btn as HTMLElement).dataset.tracked) return;
			(btn as HTMLElement).dataset.tracked = 'true';
			btn.addEventListener('click', () => {
				playSound(sfxOpen);
				const method = (btn as HTMLElement).dataset.method;
				// @ts-ignore
				if (typeof gtag === 'function') {
					// @ts-ignore
					gtag('event', 'download', {
						event_category: 'apk',
						event_label: method,
					});
				}
			});
		});
	}

	initModal();
	initDownloadTracking();
	initMainlandDownload();
	document.addEventListener("astro:page-load", () => {
			initModal();
		initDownloadTracking();
	initMainlandDownload();
	});
</script>

<style>
	.faq-list { display:grid; gap:12px; }
	.faq-item { border:1px solid #275e66; background:rgba(4,24,29,.65); }
	.faq-item summary { padding:16px; color:#8eeaf0; cursor:pointer; line-height:1.6; }
	.faq-item summary:focus-visible { outline:2px solid #00f0ff; outline-offset:3px; }
	.faq-body { padding:0 20px 20px; line-height:1.8; overflow-wrap:anywhere; }
	.faq-body p { margin:0 0 14px; }
	.faq-body ol { padding-left:24px; margin:0 0 14px; }
	.faq-body li { margin:0 0 10px; }
	.faq-body a { color:#8eeaf0; text-underline-offset:3px; }

	.offline-intro { color:#b4cfd2; line-height:1.8; margin:0 0 20px; }
	.offline-versions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
	.offline-version { min-width:0; padding:18px; background:rgba(4,24,29,.65); border:1px solid #275e66; }
	.offline-version > h3 { margin:0 0 8px; color:#8eeaf0; font-size:1.2rem; }
	.offline-version > p { margin:0 0 14px; line-height:1.7; }
	.offline-version .release-log { margin:18px 0 0; }
	@media (max-width:700px) { .offline-versions { grid-template-columns:minmax(0,1fr); } }

	.release-log { border: 1px solid #275e66; background: rgba(4, 24, 29, .65); margin-bottom: 24px; }
	.release-log summary { cursor: pointer; padding: 16px; color: #8eeaf0; line-height: 1.6; overflow-wrap: anywhere; }
	.release-log summary span:first-child { margin-right: 12px; color: #e0ffff; }
	.release-log summary:focus-visible { outline: 2px solid #00f0ff; outline-offset: 3px; }
	.release-log-content { padding: 0 16px 20px; }
	.language-guide { padding: 0 20px 20px; }
	.language-guide h3 { margin: 0 0 16px; color: #8eeaf0; font-size: 1.1rem; font-weight: 500; }
	.language-guide ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 28px; padding-left: 22px; margin: 0; }
	.language-guide li { min-width: 0; line-height: 1.7; }
	.language-guide p { margin: 0 0 10px; }
	.language-guide img { display: block; width: 100%; height: auto; border: 1px solid #275e66; }
	.restart-step { grid-column: 1 / -1; }
	@media (max-width: 700px) { .language-guide { padding: 16px; } .language-guide ol { grid-template-columns: minmax(0, 1fr); } }

	#mainland-progress { padding: 12px; background: #06262d; border: 1px solid #28717a; text-align: left; }
	#mainland-progress p { margin: 0 0 8px; font-size: .85rem; line-height: 1.5; }
	#mainland-progress progress { width: 100%; height: 8px; accent-color: #00f0ff; }
	.download-actions { display: flex; gap: 12px; margin-top: 10px; }
	.download-actions button, .download-actions a { font: inherit; font-size: .85rem; color: #c5faff; background: #103840; border: 1px solid #28717a; padding: 6px 12px; cursor: pointer; text-decoration: none; }
	#modal-download-mainland[aria-disabled="true"] { opacity: .65; cursor: progress; }

	#mainland-progress[hidden], #mainland-progress [hidden], #modal-download-mainland[hidden] { display: none; }
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 40px 20px;
	}

	.scaresoul-card {
		display: grid;
		grid-template-columns: 76px minmax(0, 1fr) auto;
		align-items: center;
		gap: 12px;
		width: min(560px, 100%);
		margin: 0 auto 28px;
		padding: 10px 12px 10px 10px;
		background: rgba(8, 8, 8, 0.84);
		border: 2px solid rgba(255, 0, 50, 0.54);
		box-shadow:
			0 0 18px rgba(255, 0, 50, 0.24),
			inset 0 0 20px rgba(255, 0, 50, 0.1);
		color: #fff;
		text-decoration: none;
		transition: border-color 0.18s ease, box-shadow 0.18s ease;
	}

	.scaresoul-card:hover {
		color: #fff;
		border-color: rgba(255, 70, 100, 0.9);
		box-shadow:
			0 0 24px rgba(255, 0, 50, 0.38),
			inset 0 0 24px rgba(255, 0, 50, 0.15);
	}

	.scaresoul-card img {
		width: 76px;
		height: 50px;
		object-fit: contain;
		filter: drop-shadow(0 0 10px rgba(255, 0, 50, 0.55));
	}

	.scaresoul-card-copy {
		display: grid;
		gap: 5px;
		min-width: 0;
	}

