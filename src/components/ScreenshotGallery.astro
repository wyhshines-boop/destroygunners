---
import chineseScreenshots from '../data/chinese-screenshots.json';
interface Props { lang?: string; hero?: boolean }
const { lang = 'en', hero = false } = Astro.props;
const originalScreenshots = [
  {
    "src": "/community/screens/hangar.webp",
    "width": 1046,
    "height": 474,
    "name": "hangar"
  },
  {
    "src": "/community/screens/battle.webp",
    "width": 1050,
    "height": 472,
    "name": "battle"
  },
  {
    "src": "/community/screens/dogfight.webp",
    "width": 1039,
    "height": 477,
    "name": "dogfight"
  },
  {
    "src": "/community/screens/friends.webp",
    "width": 1042,
    "height": 475,
    "name": "friends"
  },
  {
    "src": "/community/screens/account.webp",
    "width": 1048,
    "height": 476,
    "name": "account"
  },
  {
    "src": "/community/screens/title.webp",
    "width": 852,
    "height": 383,
    "name": "title"
  }
];
const screenshots = lang === 'zh' ? chineseScreenshots : originalScreenshots;
const copy = {
    zh: { gallery: '游戏截图', view: '查看截图' },
    en: { gallery: 'Game screenshots', view: 'View screenshot' },
    ja: { gallery: 'ゲーム画面', view: '画面を見る' },
}[lang] || { gallery: 'Game screenshots', view: 'View screenshot' };
---

<div class:list={["gallery-wrapper", { hero }]}>
    <div class="gallery-scroll" tabindex={hero ? 0 : undefined} role={hero ? 'region' : undefined} aria-label={hero ? copy.gallery : undefined}>
        {
            screenshots.map((img, index) => (
                <div class="gallery-item" data-index={index}>
                    <div class="img-frame">
                        <img
                            src={img.src}
                            alt={`Destroy Gunners ZZ — ${img.name}`}
                            width={img.width}
                            height={img.height}
                            decoding="async"
                            class="gallery-thumb"
                            loading={hero && index === 0 ? "eager" : "lazy"}
                            fetchpriority={hero && index === 0 ? "high" : "auto"}
                        />
                    </div>
                </div>
            ))
        }
    </div>
    {!hero && <div class="fake-scrollbar" aria-hidden="true">
        <div class="fake-thumb"></div>
    </div>}
    {hero && <div class="gallery-album" role="group" aria-label={copy.gallery} style={`--album-columns: ${screenshots.length}`}>
        {screenshots.map((img, index) => <button type="button" data-gallery-select={index} aria-label={`${copy.view} ${index + 1}`} aria-pressed={index === 0 ? 'true' : 'false'}>
            <img src={img.src} width={img.width} height={img.height} alt="" loading="lazy" decoding="async" />
        </button>)}
    </div>}
</div>

<!-- Lightbox lives here but gets teleported to body via JS -->
<div id="gallery-lightbox" class="lightbox-overlay" style="display:none;">
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-content">
        <button
            id="gallery-close-btn"
            class="lightbox-close"
            aria-label="Close"
        >
            <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <img id="gallery-lightbox-img" src="" alt="Enlarged screenshot" />
    </div>
</div>

<script>
    function initGalleryControls() {
        document.querySelectorAll<HTMLElement>('.gallery-wrapper.hero').forEach(wrapper => {
            if (wrapper.dataset.controlsInit) return;
            wrapper.dataset.controlsInit = 'true';
            const scroll = wrapper.querySelector<HTMLElement>('.gallery-scroll')!;
            const items = Array.from(scroll.querySelectorAll<HTMLElement>('.gallery-item'));
            const choices = Array.from(wrapper.querySelectorAll<HTMLButtonElement>('[data-gallery-select]'));
            const position = (item: HTMLElement) => Math.min(scroll.scrollWidth - scroll.clientWidth,
                item.getBoundingClientRect().left - scroll.getBoundingClientRect().left + scroll.scrollLeft);
            function current() {
                return items.reduce((best, item, index) =>
                    Math.abs(position(item) - scroll.scrollLeft) < Math.abs(position(items[best]) - scroll.scrollLeft) ? index : best, 0);
            }
            function update() {
                const selected = current();
                choices.forEach((button, index) => button.setAttribute('aria-pressed', String(index === selected)));
            }
            function select(index: number) {
                scroll.scrollTo({ left: position(items[index]), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
            }
            choices.forEach((button, index) => button.addEventListener('click', () => select(index)));
            scroll.addEventListener('keydown', event => {
                if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
                event.preventDefault();
                select((current() + (event.key === 'ArrowLeft' ? -1 : 1) + items.length) % items.length);
            });
            // Scroll events also cover browsers without scrollsnapchange support.
            scroll.addEventListener('scroll', update, { passive: true });
            scroll.addEventListener('scrollsnapchange', update);
            window.addEventListener('resize', update);
            update();
        });
    }

    function initGallery() {
        // Teleport lightbox to body to escape any parent clip-path
        const lightbox = document.getElementById("gallery-lightbox");
        if (lightbox && lightbox.parentElement !== document.body) {
            document.body.appendChild(lightbox);
            lightbox.style.display = "";
        }

        const thumbs = document.querySelectorAll(".gallery-thumb");
        const lightboxImg = document.getElementById(
            "gallery-lightbox-img",
        ) as HTMLImageElement;
        const closeBtn = document.getElementById("gallery-close-btn");
        const backdrop = lightbox?.querySelector(".lightbox-backdrop");

        if (!lightbox || !lightboxImg) return;

        const openLightbox = (src: string) => {
            lightboxImg.src = src;
            lightbox.classList.add("active");
            document.body.style.overflow = "hidden";
        };

        const closeLightbox = () => {
            lightbox.classList.remove("active");
            document.body.style.overflow = "";
        };

        // Attach click only once per thumb
        thumbs.forEach((thumb) => {
            if ((thumb as HTMLElement).dataset.lightboxInit) return;
            (thumb as HTMLElement).dataset.lightboxInit = "true";
            thumb.addEventListener("click", () => {
                openLightbox((thumb as HTMLImageElement).src);
            });
        });

        if (closeBtn && !(closeBtn as HTMLElement).dataset.lightboxInit) {
            (closeBtn as HTMLElement).dataset.lightboxInit = "true";
            closeBtn.addEventListener("click", closeLightbox);
        }

        if (backdrop && !(backdrop as HTMLElement).dataset.lightboxInit) {
            (backdrop as HTMLElement).dataset.lightboxInit = "true";
            backdrop.addEventListener("click", closeLightbox);
        }

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && lightbox.classList.contains("active")) {
                closeLightbox();
            }
        });
    }

    function initFakeScrollbar() {
        const scrolls = document.querySelectorAll<HTMLElement>(".gallery-scroll");
        scrolls.forEach((scroll) => {
            if (scroll.dataset.fakeSbInit) return;
            scroll.dataset.fakeSbInit = "true";

            const wrapper = scroll.parentElement;
            if (!wrapper) return;
            const bar = wrapper.querySelector<HTMLElement>(".fake-scrollbar");
            const thumb = wrapper.querySelector<HTMLElement>(".fake-thumb");
            if (!bar || !thumb) return;

            const update = () => {
                const { scrollLeft, scrollWidth, clientWidth } = scroll;
                const max = scrollWidth - clientWidth;
                if (max <= 0) {
                    bar.style.display = "none";
                    return;
                }
                bar.style.display = "";
                const barWidth = bar.clientWidth;
                const ratio = clientWidth / scrollWidth;
                const thumbWidth = Math.max(24, barWidth * ratio);
                const offset = (scrollLeft / max) * (barWidth - thumbWidth);
                thumb.style.width = thumbWidth + "px";
                thumb.style.transform = `translateX(${offset}px)`;
            };

            scroll.addEventListener("scroll", update, { passive: true });
            window.addEventListener("resize", update);
            // Run after layout/images settle
            requestAnimationFrame(update);
            setTimeout(update, 300);
        });
    }

    initGallery();
    initFakeScrollbar();
    initGalleryControls();
    document.addEventListener("astro:page-load", () => {
        initGallery();
        initFakeScrollbar();
        initGalleryControls();
    });
</script>

<style is:global>
    .lightbox-overlay {
        position: fixed;
        inset: 0;
        z-index: 9000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .lightbox-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    .lightbox-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.88);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }

    .lightbox-close {
        position: absolute;
        top: -42px; /* Above image on mobile */
        right: 0;
        z-index: 9002;
        background: rgba(0, 0, 0, 0.7);
        border: 1px solid rgba(0, 240, 255, 0.6);
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #00f0ff; /* Border color */
        cursor: pointer;
        transition: all 0.2s;
    }

    @media (min-width: 768px) {
        .lightbox-close {
            top: 0;
            right: -42px; /* Outside right of image on desktop */
        }
    }

    .lightbox-close svg {
        width: 20px;
        height: 20px;
    }

    .lightbox-close:hover {
        background: #00f0ff;
        color: #000;
        box-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
    }

    .lightbox-content {
        position: relative;
        z-index: 9001;
        max-width: calc(100vw - 20px); /* Mobile: nearly full width */
        max-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @media (min-width: 768px) {
        .lightbox-content {
            max-width: calc(
                100vw - 100px
            ); /* Desktop: leave room for side close button */
        }
    }

    .lightbox-content img {
        max-width: 100%;
        max-height: 90vh;
        object-fit: contain;
        border: 2px solid #00f0ff;
        box-shadow:
            0 0 60px rgba(0, 0, 0, 0.9),
            0 0 30px rgba(0, 240, 255, 0.3);
        animation: lightboxIn 0.25s ease;
    }

    @keyframes lightboxIn {
        from {
            transform: scale(0.92);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<style>
    .gallery-wrapper.hero { margin-top: 0; min-width: 0; width: 100%; }
    .gallery-wrapper.hero .gallery-scroll { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; }
    .gallery-wrapper.hero .gallery-item { flex: 0 0 100%; scroll-snap-align: start; }
    .gallery-wrapper.hero .gallery-item:hover { transform: none; }
    .gallery-album { display: grid; grid-template-columns: repeat(var(--album-columns), minmax(0, 1fr)); gap: 6px; margin-top: 10px; }
    .gallery-album button { min-width: 0; min-height: 44px; aspect-ratio: 16 / 9; padding: 2px; border: 1px solid #285c63; background: #062b32; opacity: .6; cursor: pointer; }
    .gallery-album img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .gallery-album button:hover { opacity: 1; border-color: #80f1fa; }
    .gallery-album button[aria-pressed="true"] { opacity: 1; border-color: #00f0ff; box-shadow: 0 0 6px #00c9d855; }
    .gallery-album button:focus-visible, .gallery-scroll:focus-visible { outline: 2px solid #00f0ff; outline-offset: 3px; }
    @media (max-width: 700px) {
        .gallery-wrapper.hero .gallery-item { flex-basis: 88%; }
    }

    .gallery-wrapper {
        margin-top: 30px;
    }

    .gallery-scroll {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding-bottom: 0;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none; /* Firefox */
    }
    .gallery-scroll::-webkit-scrollbar {
        display: none; /* Safari / Chrome */
    }

    /* Fake scrollbar (mobile only) */
    .fake-scrollbar {
        position: relative;
        height: 12px;
        margin-top: 10px;
        display: flex;
        align-items: center;
    }
    .fake-scrollbar::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 50%;
        height: 1px;
        background: rgba(0, 240, 255, 0.35);
        transform: translateY(-0.5px);
    }
    .fake-thumb {
        position: relative;
        height: 3px;
        background: #00f0ff;
        box-shadow: 0 0 4px rgba(0, 240, 255, 0.6);
        will-change: transform, width;
        transition: width 0.15s ease;
    }

    @media (min-width: 768px) {
        .gallery-scroll {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            overflow-x: visible;
            scroll-snap-type: none;
        }
        .fake-scrollbar {
            display: none;
        }
    }

    .gallery-item {
        flex: 0 0 80%;
        scroll-snap-align: center;
        cursor: zoom-in;
        transition: transform 0.25s ease;
    }

    @media (min-width: 768px) {
        .gallery-item {
            flex: none;
        }
        .gallery-item:hover {
            transform: scale(1.05);
            z-index: 10;
        }
    }

    .img-frame {
        border: 2px solid rgba(0, 240, 255, 0.3);
        background: rgba(8, 28, 29, 0.9);
        padding: 4px;
        clip-path: polygon(
            0 0,
            calc(100% - 14px) 0,
            100% 14px,
            100% 100%,
            14px 100%,
            0 calc(100% - 14px)
        );
        box-shadow: 0 0 12px rgba(0, 0, 0, 0.5);
        transition: border-color 0.2s;
    }

    .gallery-item:hover .img-frame {
        border-color: rgba(0, 240, 255, 0.7);
    }

    .gallery-thumb {
        width: 100%;
        height: auto;
        display: block;
        transition: filter 0.25s;
    }

    .gallery-item:hover .gallery-thumb {
        filter: brightness(1.15);
    }

</style>
