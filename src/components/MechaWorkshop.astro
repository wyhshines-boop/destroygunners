---
import type { Lang } from '../i18n/translations';
import models from '../data/workshop.json';
const { lang } = Astro.props as { lang: Lang };
const copy = {
 zh: { title:'机甲工坊', badge:'试用版', intro:'更换部件，搭配颜色，导出你的机甲。', base:'基础机型', torso:'躯干', head:'头部', arms:'双臂', legs:'双腿', back:'背部武装', none:'无', adjust:'微调部件', color:'部件叠色', original:'原色', scale:'大小', x:'左右', y:'上下', z:'前后', resetPart:'重置微调', reset:'恢复整机', frame:'居中', exportLabel:'导出 GLB', exporting:'正在导出…', loading:'正在加载模型…', ready:'拖动旋转，双指缩放。', error:'模型加载失败，请重试。', retry:'重试', exportError:'导出失败，请重试。', unsupported:'无法启动 3D 预览，请换用支持 WebGL 的浏览器。', note:'首批 3 台。混搭接缝可微调；叠色保留原贴图。', catalog:'机甲图鉴' },
 en: { title:'Mecha Workshop', badge:'Prototype', intro:'Swap parts, tint them, and export your mech.', base:'Base model', torso:'Torso', head:'Head', arms:'Arms', legs:'Legs', back:'Back equipment', none:'None', adjust:'Adjust part', color:'Part tint', original:'Original', scale:'Scale', x:'Left / right', y:'Up / down', z:'Forward / back', resetPart:'Reset adjustment', reset:'Reset mech', frame:'Center', exportLabel:'Export GLB', exporting:'Exporting…', loading:'Loading models…', ready:'Drag to rotate. Pinch to zoom.', error:'Models could not load. Please retry.', retry:'Retry', exportError:'Export failed. Please retry.', unsupported:'3D preview could not start. Try a WebGL-capable browser.', note:'First 3 mechs. Adjust mixed-part seams; tint keeps the original textures.', catalog:'Mecha catalog' },
 ja: { title:'機体工房', badge:'試作版', intro:'パーツと色を組み合わせて、機体をエクスポート。', base:'ベース機体', torso:'胴体', head:'頭部', arms:'両腕', legs:'両脚', back:'背部装備', none:'なし', adjust:'パーツ調整', color:'パーツの色', original:'元の色', scale:'サイズ', x:'左右', y:'上下', z:'前後', resetPart:'調整をリセット', reset:'機体をリセット', frame:'中央へ', exportLabel:'GLBを出力', exporting:'出力中…', loading:'モデルを読み込み中…', ready:'ドラッグで回転、ピンチで拡大・縮小。', error:'読み込めませんでした。再試行してください。', retry:'再試行', exportError:'出力できませんでした。再試行してください。', unsupported:'3Dプレビューを開始できません。WebGL対応ブラウザをお試しください。', note:'まずは3機体。継ぎ目は微調整できます。元のテクスチャを保って着色します。', catalog:'機体図鑑' },
}[lang];
const slots = ['torso','head','arms','legs','back'] as const;
const catalogHref = lang === 'en' ? '/mechas' : `/${lang}/mechas`;
---
<main class="workshop" data-workshop data-models={JSON.stringify(models)} data-copy={JSON.stringify(copy)}>
 <header class="workshop-heading"><div><p class="eyebrow">DGZZ / CUSTOM LAB <span>{copy.badge}</span></p><h1>{copy.title}</h1><p>{copy.intro}</p></div><a href={catalogHref}>{copy.catalog} ↗</a></header>
 <div class="workshop-layout">
  <section class="workshop-stage" aria-label={copy.title}>
   <div class="stage-canvas" data-canvas role="img" aria-label={`${copy.title} · ${copy.ready}`} tabindex="0"></div>
   <div class="stage-top"><span>DGZZ / <strong data-combination>DA-01</strong></span><button type="button" data-frame disabled>{copy.frame}</button></div>
   <div class="stage-bottom"><p data-status role="status" aria-live="polite">{copy.loading}</p><button type="button" data-retry hidden>{copy.retry}</button></div>
  </section>
  <aside class="workshop-controls" aria-label={copy.adjust}>
   <fieldset data-editor disabled>
    <div class="base-picker"><label for="workshop-base">{copy.base}</label><select id="workshop-base" data-base>{models.map(m => <option value={m.id}>{m.name}</option>)}</select></div>
    <div class="parts-list">{slots.map((slot,index) => <div class="part-row"><label for={`part-${slot}`}><span>{String(index+1).padStart(2,'0')}</span>{copy[slot]}</label><select id={`part-${slot}`} data-part={slot}>{models.map(m => <option value={m.id}>{m.name}</option>)}{slot!=='torso' && <option value="none">{copy.none}</option>}</select></div>)}</div>
    <details class="part-adjust" open>
     <summary>{copy.adjust}</summary>
     <div class="adjust-body">
      <label class="edit-picker" for="workshop-edit">{copy.adjust}<select id="workshop-edit" data-edit>{slots.map(slot => <option value={slot}>{copy[slot]}</option>)}</select></label>
      <div class="tint-row"><label for="part-tint">{copy.color}</label><input type="color" id="part-tint" value="#ffffff" data-tint/><button type="button" data-original>{copy.original}</button></div>
      <div class="swatches">{['#ffffff','#5bd5e9','#eb6863','#efc55b','#8893c6'].map(color => <button type="button" data-swatch={color} style={`--swatch:${color}`} aria-label={color}></button>)}</div>
      {(['x','y','z','scale'] as const).map(axis => <label class="slider-row"><span>{copy[axis]}</span><input type="range" data-axis={axis} min={axis === 'scale' ? 0.65 : -0.5} max={axis === 'scale' ? 1.4 : 0.5} step="0.01" value={axis==='scale'?1:0}/><output data-value={axis}>{axis==='scale'?'100%':'0.00'}</output></label>)}
      <button type="button" class="subtle" data-reset-part>{copy.resetPart}</button>
     </div>
    </details>
    <p class="workshop-note">{copy.note}</p>
    <div class="export-actions"><button type="button" class="subtle" data-reset>{copy.reset}</button><button type="button" class="export-button" data-export>{copy.exportLabel} ↓</button></div>
   </fieldset>
  </aside>
 </div>
</main>
<script>import '../scripts/mecha-workshop';</script>
<style>
.workshop {max-width:1240px;margin:auto;padding:36px 24px 64px;color:#d7e9e9;font-family:system-ui,sans-serif;}
.workshop-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px;}.workshop-heading h1{font-size:clamp(26px,4vw,40px);font-weight:550;letter-spacing:.04em;margin:8px 0;}.workshop-heading p{margin:0;color:#9ab5ba;font-size:14px;}.workshop-heading .eyebrow{font-family:monospace;font-size:11px;color:#64c7d0;letter-spacing:.14em;}.eyebrow span{margin-left:12px;color:#dcc591;letter-spacing:0;}.workshop-heading>a{color:#80e7ed;font-size:13px;text-decoration:none;white-space:nowrap;}
.workshop-layout{display:grid;grid-template-columns:minmax(0,1fr) 326px;gap:20px;align-items:start;}.workshop-stage{position:sticky;top:calc(var(--workshop-nav-height,64px) + 12px);min-height:610px;height:min(75vh,820px);background:radial-gradient(ellipse at 50% 40%,#193b42 0%,#0b1e26 55%,#071219 100%);overflow:hidden;border-radius:8px;box-shadow:0 18px 60px #0005;}.stage-canvas{position:absolute;inset:0;touch-action:none;}.stage-canvas :global(canvas){display:block;width:100%;height:100%;touch-action:none;}.stage-top,.stage-bottom{position:absolute;left:20px;right:20px;display:flex;align-items:center;justify-content:space-between;gap:12px;pointer-events:none;}.stage-top{top:18px;font:11px monospace;letter-spacing:.08em;color:#71969e;}.stage-top strong{font-weight:400;color:#c0e1e4;}.stage-bottom{bottom:16px;}.stage-bottom p{font-size:12px;color:#8faeb5;margin:0;}.stage-top button,.stage-bottom button{pointer-events:auto;padding:8px 12px;font-size:12px;background:#0b252cbb;}
.workshop-controls{background:#07191feF;border-radius:8px;padding:22px;}.workshop fieldset{border:0;padding:0;margin:0;min-width:0;}.workshop label{font-size:13px;color:#b7d0d3;}.workshop select{width:100%;border:1px solid #284a54;background:#102a33;color:#e0f1f2;border-radius:4px;padding:10px;font:inherit;min-height:42px;}.workshop select:focus-visible,.workshop button:focus-visible,.workshop input:focus-visible,.stage-canvas:focus-visible{outline:2px solid #83f6fa;outline-offset:3px;}.base-picker{display:grid;gap:9px;margin-bottom:16px;}.base-picker>label{color:#6bd5de;font-size:11px;letter-spacing:.08em;}.base-picker select{font-size:17px;}.parts-list{display:grid;gap:10px;}.part-row{display:grid;grid-template-columns:86px minmax(0,1fr);align-items:center;gap:8px;}.part-row label span{font:10px monospace;color:#547780;margin-right:8px;}.part-row select{font-size:12px;}.part-adjust{margin-top:22px;background:#10272e;padding:13px;border-radius:5px;}.part-adjust summary{cursor:pointer;font-size:13px;color:#8ad9df;}.adjust-body{padding-top:16px;}.edit-picker{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:center;}.edit-picker>select{font-size:12px;min-height:34px;padding:6px;}.tint-row{display:flex;align-items:center;gap:10px;margin-top:16px;}.tint-row label{flex:1;}.tint-row input{width:34px;height:28px;padding:0;border:0;background:none;cursor:pointer;}.workshop .tint-row button{font-size:11px;padding:4px 6px;}.swatches{display:flex;gap:9px;margin:12px 0 18px;}.workshop .swatches button{width:25px;height:25px;border:2px solid #ffffff33;border-radius:50%;background:var(--swatch);padding:0;}.slider-row{display:grid;grid-template-columns:44px minmax(0,1fr) 40px;align-items:center;gap:8px;margin:12px 0;}.slider-row>span{font-size:12px;}.slider-row input{width:100%;accent-color:#65d6e1;}.slider-row output{font:11px monospace;color:#7ea1aa;text-align:right;}.workshop button{font-family:inherit;cursor:pointer;color:#c1e9ed;border:0;border-radius:4px;background:#1b3c47;padding:9px 12px;}.workshop button:disabled{opacity:.5;cursor:wait;}.workshop .subtle{font-size:12px;background:transparent;color:#8baab2;padding-left:0;}.workshop-note{font-size:12px;line-height:1.7;color:#718f99;margin:18px 0;}.export-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;}.workshop .export-button{background:#73d6da;color:#082129;font-size:14px;font-weight:600;padding:12px 18px;}.workshop [hidden]{display:none;}
@media(max-width:800px){.workshop{padding:24px 16px 40px;}.workshop-layout{display:block;}.workshop-stage{z-index:2;min-height:260px;height:43svh;max-height:440px;margin-bottom:14px;}.workshop-heading{align-items:flex-start;gap:12px;}.workshop-heading>a{font-size:12px;margin-top:24px;}.workshop-controls{padding:20px;}.parts-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;}.part-row{display:grid;grid-template-columns:1fr;gap:6px;}.part-row:last-child{grid-column:1/-1;}.part-adjust{margin-top:20px;}.workshop-heading p:not(.eyebrow){max-width:240px;line-height:1.6;}}
@media(prefers-reduced-motion:reduce){.workshop *{scroll-behavior:auto;}}
</style>
