---
import Layout from '../../layouts/Layout.astro';
import ContentBox from '../ContentBox.astro';
import './admin.css';
const seo={title:'社区服管理 | Destroy Gunners',description:'Destroy Gunners 社区服管理后台',noindex:true};
---
<Layout seo={seo} admin>
 <link rel="stylesheet" href="/vendor/quill/quill.snow.css" />
 <main class="admin-shell" id="admin-app">
  <header class="admin-heading"><h1>社区服管理</h1>
   <details id="connection-settings" class="connection-fold">
    <summary><span id="connection-title">服务器连接</span><span class="connection-state"><span class="dot" id="conn"></span><span id="connection-status" role="status">未连接</span></span></summary>
    <div class="connection-popover">
     <div class="connection-controls"><label for="token">管理员 Token<input id="token" type="password" placeholder="输入 Token" autocomplete="off" /></label><button id="save" class="go">连接</button></div>
     <details class="advanced"><summary>服务器地址</summary><label for="base" class="sr-only">服务器地址</label><input id="base" type="url" placeholder="服务器地址" /></details>
    </div>
   </details>
  </header>
  <div class="admin-workspace">
   <aside class="admin-sidebar"><nav aria-label="后台功能">
    <button data-workspace="rewards" class="active" aria-current="page">玩家与奖励</button>
    <button data-workspace="history">发奖记录</button>
    <button data-workspace="notice">公告管理</button>
    <button data-workspace="event">活动图文</button>
    <button data-workspace="devil">Devil 活动</button>
   </nav></aside>
   <div class="workspace-main">
    <h2 id="workspace-title" class="sr-only">玩家与奖励</h2>
    <ContentBox>
     <div data-view="rewards"><div id="gift-retry-banner" class="gift-retry-banner" hidden><p id="gift-retry-status" role="status"></p><div class="inline-actions"><button id="gift-retry">重试原批次</button><button id="gift-records">查看记录</button><button id="gift-abandon" class="text-button">结束重试</button></div></div>
      <div class="reward-grid">
       <section aria-labelledby="players-title">
        <div class="section-heading"><h3 id="players-title">选择玩家</h3><span class="mut" id="userCount"></span></div>
        <div class="row"><label for="q" class="sr-only">搜索玩家</label><input id="q" class="grow" placeholder="搜索 UID / DGID" /><button id="search">搜索</button></div>
        <div class="box user-table"><table><thead><tr><th class="pk"><input type="checkbox" id="checkAll" aria-label="全选玩家" /></th><th>UID</th><th>Lv</th><th>DGID</th><th>更新</th></tr></thead><tbody id="users"><tr><td colspan="5" class="mut">连接服务器后显示玩家</td></tr></tbody></table></div>
       </section>
       <div class="reward-column">
        <section aria-labelledby="rewards-title">
         <div class="section-heading"><h3 id="rewards-title">发放奖励</h3></div>
         <div class="selected-target"><span>当前目标</span><strong id="sel" class="target none">未选择玩家</strong></div>
         <div class="field-heading"><label for="cashAmt">金币</label><button class="notetog text-button" data-row="cashNoteRow">添加备注</button></div>
         <div class="row"><input id="cashAmt" type="number" step="1" placeholder="数量，负数为回收" class="grow" /><button id="grantCash" class="go">发放金币</button></div>
         <div class="row noterow" id="cashNoteRow" hidden><label for="cashNote" class="sr-only">金币备注</label><input id="cashNote" class="grow" placeholder="金币备注（可选）" /></div>
         <div class="field-heading"><label for="preset">道具礼包</label><button class="notetog text-button" data-row="noteRow">添加备注</button></div>
         <div class="row"><select id="preset" class="grow"><option value="">选择礼包，或在下方逐项勾选</option></select></div>
         <div class="row noterow" id="noteRow" hidden><label for="note" class="sr-only">道具备注</label><input id="note" maxlength="1000" class="grow" placeholder="道具备注（可选）" /></div>
         <div class="reward-picker">
          <label for="item-search" class="sr-only">搜索物品</label><input id="item-search" type="search" placeholder="搜索中文名、英文名或礼物码" />
          <div class="reward-filters"><label for="item-category" class="sr-only">物品分类</label><select id="item-category"><option value="">全部分类</option><option value="weapon">武器</option><option value="shield">护盾</option><option value="upgrade">强化零件</option><option value="support">支援消耗品</option><option value="ticket">入场券</option><option value="unknown">待确认</option></select><label for="item-evidence" class="sr-only">确认状态</label><select id="item-evidence"><option value="confirmed">已确认</option><option value="device">仅实机确认</option><option value="data">仅数据确认</option><option value="unverified">待实测</option><option value="all">全部条目</option></select></div>
          <p id="item-count" class="hint" role="status">连接后加载物品</p><div id="item-results" class="reward-results"></div>
          <article id="item-detail" class="reward-detail" hidden aria-label="物品详情"></article>
          <div id="reward-selection" class="reward-selection" hidden><div class="section-heading"><span id="reward-selection-count"></span><button id="reward-clear" class="text-button">清空选择</button></div><ul id="reward-selected-items"></ul></div>
         </div>
         <details class="custom-codes" id="advanced-rewards"><summary>高级选码</summary><label for="manual" class="sr-only">礼物码</label><input id="manual" placeholder="手动输入礼物码，逗号分隔；支持范围" /><label class="unverified-ack"><input type="checkbox" id="allow-unverified" />确认在测试账号上验证待确认物品</label><p class="hint">未找到有效映射的编号不提供发放。物品编号与商店商品号不能直接当作礼物码。</p></details>
         <button id="grant" class="go grant-items">发放所选道具</button>
         <p class="hint">金币计入账户余额；道具在下次登录时进入礼物箱。</p>
        </section>
        <section class="pending-section" aria-labelledby="pending-title"><div class="section-heading"><h3 id="pending-title">待发队列</h3><div class="inline-actions"><button id="refresh" class="text-button">刷新</button><button id="revoke" class="text-button danger-text">清空</button></div></div><div class="box"><table><thead><tr><th>#</th><th>类型</th><th>内容</th><th>备注</th><th>时间</th></tr></thead><tbody id="pending"><tr><td colspan="5" class="mut">选择一名玩家后查看</td></tr></tbody></table></div></section>
       </div>
      </div>
      <details class="reference"><summary>完整物品对照表</summary><div class="reference-toolbar"><label for="reference-search" class="sr-only">搜索对照表</label><input id="reference-search" type="search" placeholder="搜索名称、礼物码、原生 ID 或商品号" /><button id="export-rewards">导出 CSV</button></div><p id="reference-stats" class="hint"></p><div class="box"><table><thead><tr><th>物品</th><th>分类</th><th>礼物码</th><th>领取数量</th><th>确认状态</th><th>原生 ID</th><th>商店商品号</th></tr></thead><tbody id="table"><tr><td colspan="7" class="mut">连接后读取</td></tr></tbody></table></div></details>
     </div>
     <section data-view="history" hidden>
      <div class="section-heading"><h3>发奖记录</h3><button id="history-selected" class="text-button">查看所选玩家</button></div>
      <div class="history-filters"><label for="history-uid">玩家 UID / DGID<input id="history-uid" placeholder="留空查看全部玩家" /></label><label for="history-kind">类型<select id="history-kind"><option value="all">全部类型</option><option value="gift">道具发奖</option><option value="coin">账户金币调整</option></select></label><label for="history-state">状态<select id="history-state"><option value="all">全部状态</option><option value="pending">含待下发</option><option value="prepared">含已生成下发数据</option><option value="revoked">含已撤销</option><option value="partial">部分处理</option><option value="posted">金币已记账</option></select></label><label for="history-since">开始日期<input id="history-since" type="date" /></label><label for="history-until">结束日期<input id="history-until" type="date" /></label><button id="history-search" class="go">查询记录</button></div>
      <p class="hint">道具“已生成下发数据”不代表客户端已收到或已领取；当前没有领取回执。金币状态以账户账本为准。日期使用本机时区。</p>
      <p id="history-status" class="hint" role="status">连接后读取</p><div id="history-list"></div><button id="history-more" hidden>加载更多</button>
     </section>
     <section data-view="content" hidden id="article-tools">
      <select id="article-kind" hidden aria-hidden="true" tabindex="-1"><option value="notice">公告</option><option value="event">活动</option></select>
      <div class="section-heading"><h3 id="article-heading">公告编辑</h3><span id="article-status" class="status-badge" role="status">连接后读取</span></div>
      <div class="content-controls"><label class="locale-field" for="article-locale">编辑语言<select id="article-locale"><option value="zh">中文</option><option value="en">English</option></select></label><button id="article-add" class="go" disabled>新增公告</button><button id="article-reload">重新读取</button><label class="deleted-toggle"><input type="checkbox" id="article-deleted" />已删除</label></div>
      <p id="article-context" class="hint">正在编辑：公告 · 中文；发布后显示在游戏面板的“公告”区域。</p><div id="article-list"></div>
     </section>
     <section data-view="devil" hidden id="devil-tools">
      <div class="section-heading"><h3>Devil 活动设置</h3><div class="inline-actions"><span id="devil-status" class="status-badge" role="status">连接后读取</span><button type="button" id="devil-refresh" class="text-button">重新读取</button></div></div>
      <form id="devil-form"><fieldset id="devil-fields" disabled>
       <label class="enable-event" for="devil-enabled"><input type="checkbox" id="devil-enabled" /><span>开启 Devil 活动</span></label>
       <div class="devil-cover-field"><span class="cover-label">活动封面</span><div class="devil-cover-preview"><img id="devil-cover-preview" alt="Devil 活动封面预览" hidden /><span id="devil-cover-empty">未设置图片</span></div><div class="cover-actions"><button type="button" id="devil-cover-choose">上传图片</button><button type="button" id="devil-cover-remove" class="text-button" hidden>移除图片</button><input id="devil-cover-file" type="file" accept="image/jpeg,image/png,image/webp" hidden /></div><p class="hint" id="devil-cover-message" role="status">建议使用横图，按原比例显示。上传后保存活动设置生效。</p></div>
       <div class="form-grid"><label class="full-field" for="devil-title">活动名称<input id="devil-title" value="Devil Event" maxlength="60" required /></label><label for="devil-start">开始时间<input id="devil-start" type="datetime-local" required /></label><label for="devil-end">结束时间<input id="devil-end" type="datetime-local" required /></label></div><p class="hint" id="devil-timezone"></p>
       <div class="form-grid three-fields"><label for="devil-step">出现积累<input id="devil-step" type="number" min="1" max="100" step="1" value="20" required /></label><label for="devil-multiplier">蓝图倍率<input id="devil-multiplier" type="number" min="1" max="10" step="1" value="2" required /></label><label for="devil-limit">每日额外蓝图上限<input id="devil-limit" type="number" min="0" max="1000" step="1" value="20" required /></label></div>
       <div class="rules-note"><p>原版出现积累为 10；数值越大，Devil 越容易出现。保留教学门槛和体力加成。</p><p>每日上限只限制额外蓝图，用完后仍获得基础 1 张。按北京时间统计，设置约 30 秒内同步。</p></div>
       <div class="form-actions"><button type="submit" id="devil-save" class="go">保存活动设置</button></div>
      </fieldset></form>
     </section>
    </ContentBox>
   </div>
  </div>
  <div id="toast" role="status" aria-live="polite"></div>
 </main>
 <script is:inline src="/vendor/quill/quill.js"></script>
 <script>import '../../scripts/admin.js';</script>
</Layout>
