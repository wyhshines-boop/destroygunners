---
import modules from '../data/da01-handcraft.json';
const {lang='zh'}=Astro.props;
const c={zh:{steps:'制作顺序',one:'先试一条腿',oneText:'髋、膝、踝先装关节，用胶板与塑料管搭骨架。确认站稳后，再加装甲。',two:'纸板试外形',twoText:'按参考图做纸壳，套在骨架外检查比例，屈膝时留出避让。',three:'胶板做外甲',threeText:'从 0.5–1 mm 模型胶板试起。大块装甲做空心盒体，连接座局部加厚。',four:'整机试装',fourText:'先拼接，再粘接；检查活动与平衡，最后补细节、涂装。',thigh:'大腿',shin:'小腿',foot:'脚',joint:'膝关节试制示意',jointText:'两片支耳夹住中间连接片，穿轴连接。先用现成关节或螺丝试装，再按实物尺寸做座。',lug:'大腿连接座',tongue:'小腿连接片',axis:'轴／螺丝',jointNote:'结构示意，不代表孔位尺寸、承重或活动范围已验证。',materials:'材料准备',materialText:'模型胶板、塑料管／棒、现成关节、轴或小螺丝；钢尺、模型刀、手钻和砂纸。按塑料材质选择胶水。',sheets:'外形定位图',sheetsText:'原模型等比例投影，用于核对外形与尺寸；不是带折线、粘接片的展开图。',scope:'打印范围',leg:'左腿三件',current:'选中模块',all:'全部模块',print:'打印 A4 参考图',printText:'按 100%／实际大小打印，关闭“适合页面”，先量下方 20 mm 校准线。',front:'正面',side:'侧面',size:'外形尺寸（宽 × 深 × 高）',height:'整机参考高度',calibrate:'20 mm 校准线',sheetNote:'仅作外形定位；接缝、板厚与关节孔位需另行设计。',empty:'请先在上方选择一个模块。'},en:{steps:'Build sequence',one:'Prototype one leg',oneText:'Fit hip, knee, and ankle joints. Build the frame with plastic sheet and tube, then check stability before adding armor.',two:'Test with card',twoText:'Make paper shells from the reference views. Check proportions and clearance while bending the knee.',three:'Build the armor',threeText:'Start with 0.5–1 mm model plastic sheet. Make large panels into hollow shells; reinforce connection mounts.',four:'Dry assemble',fourText:'Check movement and balance before gluing, detailing, and painting.',thigh:'Thigh',shin:'Shin',foot:'Foot',joint:'Knee joint concept',jointText:'Two lugs surround a central tab, connected by an axle. Trial-fit a commercial joint or screw, then measure it to build the mount.',lug:'Thigh mount',tongue:'Shin tab',axis:'Axle / screw',jointNote:'Concept only; hole locations, strength, and range of motion are untested.',materials:'Materials',materialText:'Model plastic sheet, plastic tube/rod, joints, axles or small screws; ruler, hobby knife, pin vise, and sandpaper. Match adhesive to the plastic.',sheets:'Shape reference sheets',sheetsText:'Orthographic projections from the original mesh for shape and size checks; not fold-and-glue nets.',scope:'Print range',leg:'Three left-leg modules',current:'Selected module',all:'All modules',print:'Print A4 references',printText:'Print at 100% / actual size without “fit to page”. Check the 20 mm calibration line first.',front:'Front',side:'Side',size:'Dimensions (width × depth × height)',height:'Overall reference height',calibrate:'20 mm calibration',sheetNote:'Shape reference only. Seams, thickness, and joint holes require design.',empty:'Select a module above first.'},ja:{steps:'制作手順',one:'片脚で試作',oneText:'股・膝・足首の関節を用意し、プラ板とパイプで骨格を作る。安定を確認してから外装を付ける。',two:'紙で仮組み',twoText:'参考図から紙の外装を作り、比率と膝を曲げる空間を確認する。',three:'プラ板で外装',threeText:'0.5〜1 mm の模型用プラ板から試す。大きな外装は中空にし、接続部を補強する。',four:'全体を仮組み',fourText:'可動とバランスを確認し、接着・ディテール追加・塗装を行う。',thigh:'大腿',shin:'下腿',foot:'足',joint:'膝関節の試作案',jointText:'中央の板を2枚の支持板で挟み、軸で接続する。市販関節やねじを仮組みし、実測して受けを作る。',lug:'大腿側の受け',tongue:'下腿側の接続板',axis:'軸／ねじ',jointNote:'構造図のみ。穴位置・強度・可動範囲は未検証。',materials:'用意するもの',materialText:'模型用プラ板、パイプ・棒、関節、軸・小ねじ、定規、模型ナイフ、ピンバイス、紙やすり。材質に合う接着剤を使う。',sheets:'外形確認図',sheetsText:'元モデルの正投影図。外形と寸法の確認用です。折り線やのりしろのある展開図ではありません。',scope:'印刷範囲',leg:'左脚3パーツ',current:'選択パーツ',all:'全パーツ',print:'A4資料を印刷',printText:'「用紙に合わせる」を解除し、100%・実際のサイズで印刷。20 mmの校正線を測ってください。',front:'正面',side:'側面',size:'外形寸法（幅 × 奥行 × 高さ）',height:'機体の参考高さ',calibrate:'20 mm 校正線',sheetNote:'外形確認用。継ぎ目・板厚・関節穴は別途設計が必要です。',empty:'上でパーツを選択してください。'}}[lang];
const names=(m:typeof modules[number])=>lang==='zh'?m.zh:lang==='ja'?m.original_name:m.en;
---
<div class="handcraft-guide" data-handcraft-guide>
 <section class="build-steps"><h2>{c.steps}</h2><ol>{[[c.one,c.oneText],[c.two,c.twoText],[c.three,c.threeText],[c.four,c.fourText]].map(([title,text],i)=><li><span class="step-number">0{i+1}</span><div><h3>{title}</h3><p>{text}</p>{i===0&&<div class="focus-parts">{[['left-thigh',c.thigh],['left-shin',c.shin],['left-foot',c.foot]].map(([id,label])=><button type="button" data-focus-part={id}>{label}</button>)}</div>}</div></li>)}</ol></section>
 <div class="construction"><section><h2>{c.joint}</h2><p>{c.jointText}</p><svg class="joint-diagram" viewBox="0 0 600 300" role="img" aria-label={c.joint}>
 <defs><pattern id="mount-lines" patternUnits="userSpaceOnUse" width="8" height="8"><path d="M0 8L8 0" stroke="#65b9c2" stroke-width="1"/></pattern></defs>
 <path d="M120 60H270V115H175V200H270V250H120Z" fill="url(#mount-lines)" stroke="#85dce2" stroke-width="2"/>
 <path d="M220 130H420V185H220Z" fill="#2e5665" stroke="#a8d7ea" stroke-width="2"/>
 <path d="M245 85V225" stroke="#f3ce87" stroke-width="10"/><path d="M235 85H255M235 225H255" stroke="#f3ce87" stroke-width="6"/>
 <path d="M150 60L105 35H35M345 180L410 235H550M250 90L350 45H500" fill="none" stroke="#96b9c3" stroke-width="1.5"/>
 <text x="35" y="26" fill="#d1f0f3" font-size="17">{c.lug}</text><text x="395" y="262" fill="#d1f0f3" font-size="17">{c.tongue}</text><text x="355" y="34" fill="#f3ce87" font-size="17">{c.axis}</text>
 </svg><p class="muted">{c.jointNote}</p></section><section class="materials"><h2>{c.materials}</h2><p>{c.materialText}</p><div class="assembly-path"><span>{c.thigh}</span><i>↕</i><span>{lang==='zh'?'膝关节':lang==='ja'?'膝関節':'Knee'}</span><i>↕</i><span>{c.shin}</span><i>↕</i><span>{lang==='zh'?'踝关节':lang==='ja'?'足首関節':'Ankle'}</span><i>↕</i><span>{c.foot}</span></div></section></div>
 <section class="pattern-section"><div class="pattern-header"><div><h2>{c.sheets}</h2><p>{c.sheetsText}</p></div><button type="button" class="print-button" data-print>{c.print}</button></div>
  <div class="print-options"><label>{c.scope}<select data-print-scope><option value="leg">{c.leg}</option><option value="selected">{c.current}</option><option value="all">{c.all}</option></select></label><p>{c.printText}</p></div><p data-no-sheets hidden>{c.empty}</p>
  <div class="paper-stack">{modules.map((m,index)=><article class="sheet" data-sheet={m.file} hidden={!['left-thigh','left-shin','left-foot'].includes(m.file)}>
   <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 210 297" role="img" aria-label={`DA-01 ${names(m)}`}>
    <rect width="210" height="297" fill="white"/><g fill="#152a35" font-family="system-ui,sans-serif"><text x="15" y="20" font-size="6">DA-01 / {names(m)}</text><text x="15" y="30" font-size="3.5">{c.height} <tspan data-sheet-height>180 mm</tspan></text><text x="15" y="40" font-size="3.5">{c.size} <tspan data-sheet-dims data-original-size={m.size_mm.join(',')}>{m.size_mm.map(n=>(n*1.5).toFixed(1)).join(' × ')} mm</tspan></text><text x={m.size_mm[1]*1.5>90?105:55} y="56" font-size="4" text-anchor="middle">{c.front}</text><text x={m.size_mm[1]*1.5>90?105:150} y={m.size_mm[1]*1.5>90?151:56} font-size="4" text-anchor="middle">{c.side}</text></g>
    <g transform={`translate(${m.size_mm[1]*1.5>90?105:55},65)`}><g data-pattern-shape fill="#f4f7f8" stroke="#50636d" stroke-width="0.12" stroke-linejoin="round">{m.paths.front.map(d=><path d={d}/>)}</g></g>
    <g transform={`translate(${m.size_mm[1]*1.5>90?105:150},${m.size_mm[1]*1.5>90?160:65})`}><g data-pattern-shape fill="#f4f7f8" stroke="#50636d" stroke-width="0.12" stroke-linejoin="round">{m.paths.side.map(d=><path d={d}/>)}</g></g>
    <g fill="#29424d" font-family="system-ui,sans-serif"><text x="15" y="246" font-size="3.5">{c.calibrate}</text><path d="M15 254H35M15 251V257M35 251V257" stroke="#152a35" stroke-width="0.3"/><text x="15" y="273" font-size="3">{c.sheetNote}</text><text x="15" y="283" font-size="3">DGZZ / {m.file} / {String(index+1).padStart(2,'0')}</text></g>
   </svg>
  </article>)}</div>
 </section>
</div>
<script>import '../scripts/handcraft-reference';</script>
<style>
.handcraft-guide{margin-top:36px}.handcraft-guide h2{font-size:21px;font-weight:550;margin:0 0 14px}.handcraft-guide h3{font-size:16px;font-weight:550;margin:0 0 7px}.handcraft-guide p{font-size:14px;line-height:1.8;color:#adc9cf;margin:0}.build-steps ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:0;list-style:none;gap:22px;margin:0}.build-steps li{display:flex;gap:12px;background:#09222bf2;padding:18px}.step-number{font:13px monospace;color:#64dce5;padding-top:3px}.focus-parts{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}.handcraft-guide button,.print-options select{font:13px system-ui;min-height:44px;padding:9px 13px;color:#c8f4f7;background:#163b46;border:1px solid #3b6570;cursor:pointer}.handcraft-guide button:focus-visible,.print-options select:focus-visible{outline:2px solid #9affff;outline-offset:3px}.construction{display:grid;grid-template-columns:1.5fr 1fr;gap:26px;margin-top:26px}.construction section{padding:22px;background:#09222bf2}.joint-diagram{display:block;width:100%;height:auto;margin:12px 0}.handcraft-guide .muted{font-size:12px;color:#89aeb8}.assembly-path{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:25px;font-size:13px}.assembly-path span{padding:9px;background:#17404c}.assembly-path i{color:#7bdce4;font-style:normal}.pattern-section{margin-top:36px}.pattern-header{display:flex;justify-content:space-between;gap:20px;align-items:start}.handcraft-guide .print-button{background:#75dce0;color:#08212a;font-weight:600;white-space:nowrap}.print-options{margin:18px 0 22px;padding:16px;background:#09222bf2;display:flex;align-items:center;gap:24px}.print-options label{display:flex;align-items:center;gap:12px;white-space:nowrap;font-size:13px}.print-options select{max-width:220px}.print-options p{font-size:12px}.paper-stack{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:start}.sheet{background:white;box-shadow:0 8px 25px #0004}.sheet svg{display:block;width:100%;height:auto}.handcraft-guide [hidden]{display:none!important}
@media(max-width:1000px){.build-steps ol{grid-template-columns:repeat(2,minmax(0,1fr))}.construction{grid-template-columns:1fr}.paper-stack{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.build-steps ol{grid-template-columns:1fr;gap:12px}.construction{gap:14px}.pattern-header{flex-direction:column}.print-options{flex-direction:column;align-items:start;gap:12px}.print-options label{flex-wrap:wrap}.paper-stack{grid-template-columns:1fr}.sheet{max-width:500px}.handcraft-guide p{font-size:13px}}
</style>
<style is:global>
@media print{
 @page{size:A4 portrait;margin:0}
 html,body{height:auto!important;min-height:0!important;background:white!important;color:black!important;overflow:visible!important}
 body::before,.global-navbar,.parts-reference>header,.craft-toolbar,.reference-layout,.build-steps,.construction,.pattern-header,.print-options,[data-no-sheets],astro-dev-toolbar{display:none!important}
 body>header,body>footer{display:none!important}
 .parts-reference{padding:0!important;margin:0!important;max-width:none!important}
 .handcraft-guide,.pattern-section,.paper-stack{display:block!important;margin:0!important;padding:0!important}
 .paper-stack .sheet{display:block;box-shadow:none!important;margin:0!important;width:210mm;height:297mm;break-after:page;break-inside:avoid}
 .paper-stack .sheet:last-child{break-after:auto}
 .paper-stack .sheet svg{display:block;width:210mm!important;height:297mm!important;max-width:none!important}
 .paper-stack .sheet[hidden]{display:none!important}
}
</style>
