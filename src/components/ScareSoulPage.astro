---
import type { Lang } from '../i18n/translations';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const copy = {
	en: {
		kicker: 'Offline cracked edition',
		title: 'ScareSoul Offline Cracked Edition',
		description:
			'A preserved offline build of SHADE Inc.\'s gothic action RPG. Explore cursed arenas, collect weapons, and keep this lost mobile title playable. Fan-made cracked edition for preservation and offline play. Recommended for Android devices with legacy 32-bit compatibility.',
		download: 'Download',
		gallery: 'Screenshots',
		home: 'HomePage',
	},
	zh: {
		kicker: '离线破解版',
		title: 'ScareSoul Offline Cracked Edition',
		description:
			'SHADE Inc. 哥特暗黑动作 RPG 的离线版本。进入被诅咒的竞技场，收集武器，让这款消失的移动端作品继续可玩。这是粉丝自制的破解版，用于游戏离线游玩。建议使用仍支持 32 位应用的 Android 设备。联系：wyhshines@gmail.com',
		download: '下载',
		gallery: '游戏截图',
		home: '首页',
	},
	ja: {
		kicker: 'オフライン改造版',
		title: 'ScareSoul Offline Cracked Edition',
		description:
			'SHADE Inc. のゴシックアクション RPG を保存するためのオフライン版です。呪われた闘技場を探索し、武器を集め、失われたモバイル作品を遊べる形で残します。保存とオフラインプレイのためのファンメイド版です。32-bit アプリ互換環境のある Android 端末を推奨します。',
		download: 'Download',
		gallery: 'Screenshots',
		home: 'HomePage',
	},
}[lang];

const screenshots = [
	'/scaresoul/shot1.jpg',
	'/scaresoul/shot2.jpg',
	'/scaresoul/shot3.jpg',
	'/scaresoul/shot4.jpg',
	'/scaresoul/shot5.png',
	'/scaresoul/shot6.png',
	'/scaresoul/shot7.jpg',
];
---

<main class="scaresoul-page">
	<section class="hero" aria-labelledby="scaresoul-title">
		<div class="home-card">
			<img src="/scaresoul/dg_logo.webp" alt="Destroy Gunners" />
			<div class="home-card-copy">
				<strong>Destroy Gunners</strong>
				<span>Offline Cracked Edition</span>
			</div>
			<a href="/" class="home-card-button">{copy.home}</a>
		</div>

		<img class="game-logo" src="/scaresoul/scaresoul_logo.webp" alt="ScareSoul" />

		<div class="content-frame">
			<h1 id="scaresoul-title">{copy.title}</h1>
			<p class="lead">{copy.description}</p>

			<div class="screenshot-carousel" aria-label={copy.gallery}>
				<button class="carousel-control prev" type="button" aria-label="Previous screenshot">‹</button>
				<div class="carousel-viewport">
					<div class="carousel-track">
						{screenshots.map((shot, index) => (
							<a href={shot} class="shot-card" target="_blank" rel="noopener">
								<img src={shot} alt={`ScareSoul screenshot ${index + 1}`} loading={index < 3 ? 'eager' : 'lazy'} />
							</a>
						))}
					</div>
				</div>
				<button class="carousel-control next" type="button" aria-label="Next screenshot">›</button>
			</div>

			<div class="carousel-dots" aria-label="Screenshot pages">
				{screenshots.map((_, index) => (
					<button class={index === 0 ? 'active' : ''} type="button" aria-label={`Go to screenshot ${index + 1}`} data-slide={index}></button>
				))}
			</div>
		</div>

		<a class="download-button scaresoul-download-track" href="/downloads/scaresoul_offline.apk" download>
			<span>{copy.download}</span>
		</a>
	</section>
</main>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: #000;
		overflow: hidden;
	}

	body {
		overflow-x: hidden;
	}

	* {
		box-sizing: border-box;
	}

</style>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700&display=swap');

	.scaresoul-page {
		--blood: #df0033;
		--blood-deep: #6d000d;
		--ember: #ff4b2f;
		--paper: #fff4ef;
		--muted: rgba(255, 244, 239, 0.74);
		height: 100vh;
		height: 100svh;
		overflow: hidden;
		color: var(--paper);
		font-family: "Noto Serif SC", "Songti SC", "SimSun", serif;
		letter-spacing: 0;
		background-image:
			linear-gradient(90deg, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.04) 50%, rgba(0, 0, 0, 0.5)),
			linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.28)),
			url('/scaresoul/scaresoul_bg.png');
		background-size: cover;
		background-position: center top;
		background-repeat: no-repeat;
		background-attachment: fixed;
	}

	.hero {
		height: 100vh;
		height: 100svh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: clamp(12px, 2vh, 22px) 24px clamp(14px, 2.2vh, 26px);
		position: relative;
		overflow: hidden;
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: auto 0 0;
		height: 34%;
		background: radial-gradient(ellipse at center bottom, rgba(216, 0, 42, 0.72), transparent 62%);
		pointer-events: none;
	}

	.home-card {
		width: min(360px, 46vw);
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr) auto;
		align-items: center;
		gap: 8px;
		margin: 0 auto clamp(6px, 1vh, 10px);
		padding: 5px 10px 5px 5px;
		position: relative;
		background: rgba(8, 8, 8, 0.86);
		border: 2px solid rgba(255, 255, 255, 0.88);
		color: #fff;
		font-family: "Roboto Condensed", "Arial Narrow", "Noto Serif SC", sans-serif;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.38);
	}

	.home-card img {
		width: 52px;
		aspect-ratio: 1 / 1;
		display: block;
		object-fit: cover;
	}

	.home-card-copy {
		display: grid;
		gap: 4px;
		text-align: left;
	}

	.home-card-copy strong {
		font-size: clamp(0.8rem, 1.05vw, 1rem);
		line-height: 1.05;
		font-weight: 700;
		letter-spacing: 0;
	}

	.home-card-copy span {
		font-size: clamp(0.62rem, 0.78vw, 0.76rem);
		line-height: 1.15;
		color: rgba(255, 255, 255, 0.86);
	}

	.home-card-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 78px;
		min-height: 28px;
		padding: 5px 8px;
		border: 2px solid rgba(255, 255, 255, 0.86);
		color: #fff;
		text-decoration: none;
		font-size: clamp(0.66rem, 0.84vw, 0.82rem);
		line-height: 1;
		background: rgba(255, 255, 255, 0.02);
		transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
	}

	.home-card-button:hover {
		color: #fff;
		border-color: var(--ember);
		background: rgba(255, 0, 35, 0.12);
	}

	.content-frame {
		width: min(1500px, 100%);
		position: relative;
		text-align: center;
		padding: clamp(28px, 4vh, 44px) clamp(22px, 5vw, 72px) clamp(30px, 4.2vh, 46px);
		background:
			linear-gradient(rgba(0, 0, 0, 0.42), rgba(0, 0, 0, 0.52)),
			radial-gradient(circle at 50% 0, rgba(255, 0, 64, 0.14), transparent 42%);
		border: 0;
		box-shadow:
			0 0 10px rgba(255, 0, 35, 0.18),
			0 0 24px rgba(255, 0, 35, 0.08),
			inset 0 0 10px rgba(255, 0, 35, 0.12),
			inset 0 0 26px rgba(255, 0, 35, 0.05);
	}

	.content-frame::before,
	.content-frame::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		height: 16px;
		background: linear-gradient(90deg, transparent, rgba(255, 0, 35, 0.16) 8%, rgba(255, 0, 35, 0.26) 50%, rgba(255, 0, 35, 0.16) 92%, transparent);
		filter: blur(8px);
		opacity: 0.46;
		pointer-events: none;
	}

	.content-frame::before {
		top: -8px;
	}

	.content-frame::after {
		bottom: -8px;
	}

	.game-logo {
		width: min(460px, 58vw);
		height: auto;
		margin: 0 auto clamp(14px, 2.2vh, 24px);
		display: block;
		filter: drop-shadow(0 0 16px rgba(255, 0, 56, 0.78));
	}

	h1 {
		margin: 0 auto;
		max-width: 1180px;
		font-size: clamp(1.8rem, 3.35vw, 3.25rem);
		font-weight: 400;
		line-height: 1.12;
		text-shadow: 0 4px 18px rgba(0, 0, 0, 0.9), 0 0 12px rgba(255, 255, 255, 0.24);
	}

	.lead {
		max-width: 980px;
		margin: clamp(12px, 1.8vh, 18px) auto 0;
		color: var(--muted);
		font-size: clamp(0.98rem, 1.45vw, 1.28rem);
		line-height: 1.55;
		text-shadow: 0 2px 10px #000;
	}

	.screenshot-carousel {
		width: min(1100px, 100%);
		margin: clamp(18px, 3vh, 30px) auto 0;
		position: relative;
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.carousel-viewport {
		width: 100%;
		overflow: hidden;
	}

	.carousel-track {
		display: flex;
		gap: clamp(12px, 2vw, 24px);
		transition: transform 0.38s ease;
		will-change: transform;
	}

	.shot-card {
		display: block;
		overflow: hidden;
		background: #050505;
		border: 1px solid rgba(255, 244, 239, 0.78);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.58);
		transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
	}

	.shot-card {
		flex: 0 0 calc((100% - clamp(12px, 2vw, 24px) * 2) / 3);
		aspect-ratio: 20 / 9;
	}

	.carousel-control {
		width: 38px;
		height: 86px;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		border: 1px solid rgba(255, 0, 40, 0.62);
		background: rgba(0, 0, 0, 0.46);
		color: rgba(255, 255, 255, 0.9);
		font-family: Georgia, serif;
		font-size: 3.2rem;
		line-height: 1;
		cursor: pointer;
		box-shadow: inset 0 0 14px rgba(255, 0, 35, 0.26), 0 0 10px rgba(255, 0, 35, 0.35);
		transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
	}

	.carousel-control:hover {
		color: #fff;
		border-color: #fff;
		transform: scale(1.04);
	}

	.carousel-dots {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-top: clamp(8px, 1.3vh, 12px);
	}

	.carousel-dots button {
		width: 34px;
		height: 3px;
		padding: 0;
		border: 0;
		background: rgba(255, 244, 239, 0.34);
		cursor: pointer;
		box-shadow: 0 0 8px transparent;
	}

	.carousel-dots button.active {
		background: #fff;
		box-shadow: 0 0 10px rgba(255, 0, 35, 0.9);
	}

	.shot-card:hover {
		border-color: var(--ember);
		box-shadow: 0 0 12px rgba(255, 0, 45, 0.5), 0 12px 30px rgba(0, 0, 0, 0.58);
	}

	.shot-card img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}

	.download-button {
		width: fit-content;
		min-width: min(360px, 82vw);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		position: relative;
		isolation: isolate;
		margin-top: 50px;
		padding: 0.08em 24px 0.18em;
		color: #fff;
		font-size: clamp(2.5rem, 5.8vw, 4.6rem);
		line-height: 1.05;
		text-decoration: none;
		text-shadow: 0 0 8px rgba(255, 255, 255, 0.62), 0 0 12px rgba(255, 0, 40, 0.58);
		transition: transform 0.18s ease, filter 0.18s ease;
	}

	.download-button::before {
		content: "";
		position: absolute;
		left: 50%;
		top: 50%;
		z-index: 0;
		width: 132%;
		height: 112%;
		transform: translate(-50%, -50%);
		background: radial-gradient(ellipse at center, rgba(255, 0, 55, 0.34), rgba(255, 0, 55, 0.1) 48%, transparent 66%);
		pointer-events: none;
	}

	.download-button span {
		position: relative;
		z-index: 1;
	}

	.download-button:hover {
		color: #fff;
		transform: scale(1.03);
		filter: brightness(1.2);
		text-shadow: 0 0 10px #fff, 0 0 16px var(--blood);
	}

	@media (max-width: 820px) {
		.scaresoul-page {
			background-attachment: scroll;
			background-position: center top;
		}

		.hero::before {
			display: block;
			height: 30%;
			background: radial-gradient(ellipse at center bottom, rgba(216, 0, 42, 0.52), rgba(216, 0, 42, 0.2) 38%, transparent 68%);
		}

		.hero {
			height: 100svh;
			justify-content: center;
			padding: 70px 10px max(8px, env(safe-area-inset-bottom));
		}

		.home-card {
			position: absolute;
			top: max(14px, env(safe-area-inset-top));
			left: 50%;
			transform: translateX(-50%);
			width: min(340px, 88vw);
			grid-template-columns: 40px minmax(0, 1fr) auto;
			gap: 7px;
			margin: 0;
			padding: 4px 6px 4px 4px;
			border-width: 2px;
		}

		.home-card img {
			width: 40px;
		}

		.home-card-copy strong {
			font-size: clamp(0.76rem, 3.4vw, 0.92rem);
		}

		.home-card-copy span {
			display: block;
			font-size: clamp(0.52rem, 2.45vw, 0.66rem);
		}

		.home-card-button {
			grid-column: auto;
			width: auto;
			min-width: 0;
			min-height: 25px;
			padding: 4px 7px;
			border-width: 1px;
			font-size: 0.68rem;
		}

		.content-frame {
			width: 92vw;
			padding: 16px 14px 17px;
		}

		.game-logo {
			width: min(235px, 58vw);
			margin-bottom: 10px;
		}

		h1 {
			font-size: clamp(1.18rem, 6.2vw, 1.64rem);
			line-height: 1.06;
		}

		.lead {
			margin-top: 12px;
			font-size: clamp(0.62rem, 2.9vw, 0.76rem);
			line-height: 1.2;
		}

		.screenshot-carousel {
			width: min(84vw, 420px);
			margin-top: 14px;
			gap: 8px;
		}

		.shot-card {
			flex-basis: 100%;
		}

		.carousel-control {
			position: absolute;
			z-index: 2;
			width: 25px;
			height: 44px;
			font-size: 2.1rem;
			background: rgba(0, 0, 0, 0.62);
		}

		.carousel-control.prev {
			left: 0;
		}

		.carousel-control.next {
			right: 0;
		}

		.carousel-dots {
			margin-top: 9px;
			gap: 6px;
		}

		.carousel-dots button {
			width: 26px;
			height: 3px;
		}

		.download-button {
			height: clamp(58px, 12.5vw, 76px);
			margin-top: 50px;
			min-width: min(250px, 68vw);
			padding: 0 14px;
			font-size: clamp(2rem, 9.8vw, 2.72rem);
			line-height: 1;
			text-shadow: 0 0 7px rgba(255, 255, 255, 0.5), 0 0 9px rgba(255, 0, 40, 0.38);
		}

		.download-button::before {
			width: 260%;
			height: 190%;
			background: radial-gradient(ellipse at center, rgba(255, 0, 55, 0.32), rgba(255, 0, 55, 0.14) 42%, rgba(255, 0, 55, 0.05) 64%, transparent 78%);
		}
	}

	@media (max-width: 380px) {
		.hero {
			padding-top: 66px;
		}

		.home-card {
			width: 92vw;
			grid-template-columns: 36px minmax(0, 1fr) auto;
		}

		.home-card img {
			width: 36px;
		}

		.home-card-copy strong {
			font-size: 0.7rem;
		}

		.home-card-copy span {
			font-size: 0.5rem;
		}

		.home-card-button {
			padding: 5px 8px;
			font-size: 0.62rem;
		}

		.game-logo {
			width: min(205px, 56vw);
			margin-bottom: 8px;
		}

		.content-frame {
			padding: 14px 11px 15px;
		}

		h1 {
			font-size: 1.08rem;
		}

		.lead {
			font-size: 0.58rem;
			margin-top: 10px;
		}

		.screenshot-carousel {
			margin-top: 12px;
		}

		.download-button {
			margin-top: 50px;
			height: 54px;
			min-width: min(220px, 66vw);
			font-size: 1.82rem;
		}

		.download-button::before {
			width: 250%;
			height: 185%;
			background: radial-gradient(ellipse at center, rgba(255, 0, 55, 0.3), rgba(255, 0, 55, 0.12) 42%, rgba(255, 0, 55, 0.05) 64%, transparent 78%);
		}
	}
</style>

<script>
	function initScareSoulCarousel() {
		const track = document.querySelector('.carousel-track');
		const cards = Array.from(document.querySelectorAll('.shot-card'));
		const prev = document.querySelector('.carousel-control.prev');
		const next = document.querySelector('.carousel-control.next');
		const dots = Array.from(document.querySelectorAll('.carousel-dots button'));
		if (!track || cards.length === 0 || !prev || !next) return;

		let index = 0;
		let timer;

		function visibleCount() {
			return window.matchMedia('(max-width: 820px)').matches ? 1 : 3;
		}

		function maxIndex() {
			return Math.max(0, cards.length - visibleCount());
		}

		function update() {
			index = Math.max(0, Math.min(index, maxIndex()));
			const firstCard = cards[0];
			const gap = parseFloat(getComputedStyle(track).columnGap || '0');
			const offset = index * (firstCard.getBoundingClientRect().width + gap);
			track.style.transform = `translateX(-${offset}px)`;
			dots.forEach((dot, dotIndex) => dot.classList.toggle('active', dotIndex === index));
		}

		function go(nextIndex) {
			index = nextIndex > maxIndex() ? 0 : nextIndex < 0 ? maxIndex() : nextIndex;
			update();
		}

		function restartAutoPlay() {
			window.clearInterval(timer);
			timer = window.setInterval(() => go(index + 1), 4200);
		}

		prev.addEventListener('click', () => {
			go(index - 1);
			restartAutoPlay();
		});

		next.addEventListener('click', () => {
			go(index + 1);
			restartAutoPlay();
		});

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				go(Number(dot.getAttribute('data-slide') || 0));
				restartAutoPlay();
			});
		});

		window.addEventListener('resize', update);
		update();
		restartAutoPlay();
	}

	initScareSoulCarousel();
	document.addEventListener('astro:page-load', initScareSoulCarousel);

	function initScareSoulDownloadTracking() {
		document.querySelectorAll('.scaresoul-download-track').forEach(link => {
			if ((link as HTMLElement).dataset.tracked) return;
			(link as HTMLElement).dataset.tracked = 'true';
			link.addEventListener('click', () => {
				// @ts-ignore
				if (typeof gtag === 'function') {
					// @ts-ignore
					gtag('event', 'download', {
						event_category: 'apk',
						event_label: 'scaresoul_offline_v8',
						file_name: 'scaresoul_offline.apk',
						game: 'scaresoul',
					});
				}
			});
		});
	}

	initScareSoulDownloadTracking();
	document.addEventListener('astro:page-load', initScareSoulDownloadTracking);
</script>
