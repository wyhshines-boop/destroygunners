---
import type { Lang } from '../i18n/translations';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import novelSource from '../../public/scaresoul/scaresoul_novel.md?raw';
import itemsSource from '../../public/scaresoul/scaresoul_items.md?raw';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const copy = {
	en: {
		kicker: 'Offline cracked edition',
		title: 'ScareSoul Offline Cracked Edition',
		description:
			'A preserved offline build of SHADE Inc.\'s gothic action RPG. Explore cursed arenas, collect weapons, and keep this lost mobile title playable. Fan-made cracked edition for preservation and offline play. Recommended for Android devices with legacy 32-bit compatibility.',
		updateTitle: 'Update notes',
		updateNotes: [
			'Current version: 1.5.1c.',
			'Fixed the lottery and reward-claim systems. You can now draw elemental enchantment materials without limit from the Common pool and obtain rare weapons from the Legend pool.',
			'Unlimited souls.',
			'Removed the disruptive daily login reward flow.',
			'Added support for hiding the gesture navigation bar by default for a more immersive gameplay experience.',
		],
		download: 'Download',
		gallery: 'Screenshots',
		home: 'HomePage',
		story: 'Story',
		closeStory: 'Close story',
		weapons: 'Weapons',
		materials: 'Items & Materials',
		closeWeapons: 'Close weapons',
		closeMaterials: 'Close items and materials',
	},
	zh: {
		kicker: '离线破解版',
		title: '恐惧之魂离线破解版',
		description:
			'SHADE Inc. 哥特暗黑动作 RPG 的离线版本。进入被诅咒的竞技场，收集武器，让这款消失的移动端作品继续可玩。这是粉丝自制的破解版，用于游戏离线游玩。建议使用仍支持 32 位应用的 Android 设备。',
		updateTitle: '更新日志',
		updateNotes: [
			'当前版本：1.5.1c。',
			'修复了抽奖和领取奖励系统。现在你可以通过 Common 池无限抽取元素附魔材料，通过 Legend 池获取稀有武器！',
			'无限灵魂。',
			'移除了扰人的每日登录奖励流程。',
			'新增支持手势导航条默认隐藏，带来沉浸式的游戏体验。',
		],
		download: '下载',
		gallery: '游戏截图',
		home: '首页',
		story: '故事',
		closeStory: '关闭故事',
		weapons: '武器',
		materials: '材料',
		closeWeapons: '关闭武器表格',
		closeMaterials: '关闭道具和材料表格',
	},
	ja: {
		kicker: 'オフライン改造版',
		title: 'ScareSoul Offline Cracked Edition',
		description:
			'SHADE Inc. のゴシックアクション RPG を保存するためのオフライン版です。呪われた闘技場を探索し、武器を集め、失われたモバイル作品を遊べる形で残します。保存とオフラインプレイのためのファンメイド版です。32-bit アプリ互換環境のある Android 端末を推奨します。',
		updateTitle: '更新履歴',
		updateNotes: [
			'現在のバージョン：1.5.1c。',
			'ガチャと報酬受取システムを修正しました。Common プールから属性付与素材を無制限に引けるようになり、Legend プールからレア武器を入手できます。',
			'ソウルを無制限にしました。',
			'煩わしいデイリーログイン報酬のフローを削除しました。',
			'ジェスチャーナビゲーションバーをデフォルトで非表示にする機能を追加し、より没入感のあるゲーム体験を実現しました。',
		],
		download: 'Download',
		gallery: 'Screenshots',
		home: 'HomePage',
		story: 'ストーリー',
		closeStory: 'ストーリーを閉じる',
		weapons: '武器',
		materials: 'アイテム・素材',
		closeWeapons: '武器一覧を閉じる',
		closeMaterials: 'アイテムと素材一覧を閉じる',
	},
}[lang];

const markdownProcessor = await createMarkdownProcessor();
const { code: novelHtml } = await markdownProcessor.render(novelSource);
const weaponsStart = itemsSource.indexOf('## ⚔️ 武器');
const materialsStart = itemsSource.indexOf('## 🧪 道具 / 材料');
const weaponsSource = itemsSource.slice(weaponsStart, materialsStart).trim();
const materialsSource = itemsSource.slice(materialsStart).trim();
const { code: weaponsHtml } = await markdownProcessor.render(weaponsSource);
const { code: materialsHtml } = await markdownProcessor.render(materialsSource);

const screenshots = [
	'/scaresoul/shot1.jpg',
	'/scaresoul/shot2.jpg',
	'/scaresoul/shot3.jpg',
	'/scaresoul/shot4.jpg',
	'/scaresoul/shot5.png',
	'/scaresoul/shot6.png',
	'/scaresoul/shot7.jpg',
];
---

<main class="scaresoul-page">
	<section class="hero" aria-labelledby="scaresoul-title">
		<img class="game-logo" src="/scaresoul/scaresoul_logo.webp" alt="ScareSoul" />

		<div class="content-frame">
			<nav class="feature-actions" aria-label="ScareSoul content">
				<a class="feature-button" href="/">{copy.home}</a>
				<button class="feature-button content-open" type="button" data-modal-target="story-modal">{copy.story}</button>
				<button class="feature-button content-open" type="button" data-modal-target="weapons-modal">{copy.weapons}</button>
				<button class="feature-button content-open" type="button" data-modal-target="materials-modal">{copy.materials}</button>
			</nav>
			<h1 id="scaresoul-title">{copy.title}</h1>
			<p class="lead">{copy.description}</p>
			<div class="update-notes">
				<h2>{copy.updateTitle}</h2>
				<ul>
					{copy.updateNotes.map(note => <li>{note}</li>)}
				</ul>
			</div>

			<div class="screenshot-carousel" aria-label={copy.gallery}>
				<button class="carousel-control prev" type="button" aria-label="Previous screenshot">‹</button>
				<div class="carousel-viewport">
					<div class="carousel-track">
						{screenshots.map((shot, index) => (
							<button class="shot-card" type="button" data-full-src={shot} data-shot-index={index} aria-label={`Open ScareSoul screenshot ${index + 1}`}>
								<img src={shot} alt={`ScareSoul screenshot ${index + 1}`} loading={index < 3 ? 'eager' : 'lazy'} />
							</button>
						))}
					</div>
				</div>
				<button class="carousel-control next" type="button" aria-label="Next screenshot">›</button>
			</div>

			<div class="carousel-dots" aria-label="Screenshot pages">
				{screenshots.map((_, index) => (
					<button class={index === 0 ? 'active' : ''} type="button" aria-label={`Go to screenshot ${index + 1}`} data-slide={index}></button>
				))}
			</div>
		</div>

		<a class="download-button scaresoul-download-track" href="/downloads/scaresoul_offline.apk" download>
			<span>{copy.download}</span>
		</a>
	</section>

	<div class="lightbox" aria-hidden="true">
		<button class="lightbox-close" type="button" aria-label="Close screenshot">×</button>
		<button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous screenshot">‹</button>
		<img class="lightbox-image" src="" alt="ScareSoul enlarged screenshot" />
		<button class="lightbox-nav lightbox-next" type="button" aria-label="Next screenshot">›</button>
	</div>

	<div class="story-modal content-modal" id="story-modal" aria-hidden="true">
		<section class="story-dialog" role="dialog" aria-modal="true" aria-labelledby="story-dialog-title">
			<header class="story-dialog-header">
				<h2 id="story-dialog-title">{copy.story}</h2>
				<button class="story-close" type="button" aria-label={copy.closeStory}>×</button>
			</header>
			<article class="story-content" set:html={novelHtml} />
		</section>
	</div>

	<div class="story-modal content-modal" id="weapons-modal" aria-hidden="true">
		<section class="story-dialog catalog-dialog" role="dialog" aria-modal="true" aria-labelledby="weapons-dialog-title">
			<header class="story-dialog-header">
				<h2 id="weapons-dialog-title">{copy.weapons}</h2>
				<button class="story-close content-close" type="button" aria-label={copy.closeWeapons}>×</button>
			</header>
			<article class="story-content catalog-content" set:html={weaponsHtml} />
		</section>
	</div>

	<div class="story-modal content-modal" id="materials-modal" aria-hidden="true">
		<section class="story-dialog catalog-dialog" role="dialog" aria-modal="true" aria-labelledby="materials-dialog-title">
			<header class="story-dialog-header">
				<h2 id="materials-dialog-title">{copy.materials}</h2>
				<button class="story-close content-close" type="button" aria-label={copy.closeMaterials}>×</button>
			</header>
			<article class="story-content catalog-content" set:html={materialsHtml} />
		</section>
	</div>
</main>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: #000;
		overflow: hidden;
	}

	body {
		overflow-x: hidden;
	}

	* {
		box-sizing: border-box;
	}

</style>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700&display=swap');

	.scaresoul-page {
		--blood: #df0033;
		--blood-deep: #6d000d;
		--ember: #ff4b2f;
		--paper: #fff4ef;
		--muted: rgba(255, 244, 239, 0.74);
		height: 100vh;
		height: 100svh;
		overflow-x: hidden;
		overflow-y: auto;
		color: var(--paper);
		font-family: "Noto Serif SC", "Songti SC", "SimSun", serif;
		letter-spacing: 0;
		background-image:
			linear-gradient(90deg, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.04) 50%, rgba(0, 0, 0, 0.5)),
			linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.28)),
			url('/scaresoul/scaresoul_bg.png');
		background-size: cover;
		background-position: center top;
		background-repeat: no-repeat;
		background-attachment: fixed;
	}

	.hero {
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: clamp(12px, 2vh, 22px) 24px clamp(14px, 2.2vh, 26px);
		position: relative;
		overflow: hidden;
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: auto 0 0;
		height: 34%;
		background: radial-gradient(ellipse at center bottom, rgba(216, 0, 42, 0.72), transparent 62%);
		pointer-events: none;
	}

	.content-frame {
		width: min(1500px, 100%);
		position: relative;
		text-align: center;
		padding: clamp(28px, 4vh, 44px) clamp(22px, 5vw, 72px) clamp(30px, 4.2vh, 46px);
		background:
			linear-gradient(rgba(0, 0, 0, 0.42), rgba(0, 0, 0, 0.52)),
			radial-gradient(circle at 50% 0, rgba(255, 0, 64, 0.14), transparent 42%);
		border: 0;
		box-shadow:
			0 0 10px rgba(255, 0, 35, 0.18),
			0 0 24px rgba(255, 0, 35, 0.08),
			inset 0 0 10px rgba(255, 0, 35, 0.12),
			inset 0 0 26px rgba(255, 0, 35, 0.05);
	}

	.content-frame::before,
	.content-frame::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		height: 16px;
		background: linear-gradient(90deg, transparent, rgba(255, 0, 35, 0.16) 8%, rgba(255, 0, 35, 0.26) 50%, rgba(255, 0, 35, 0.16) 92%, transparent);
		filter: blur(8px);
		opacity: 0.46;
		pointer-events: none;
	}

	.content-frame::before {
		top: -8px;
	}

	.content-frame::after {
		bottom: -8px;
	}

	.game-logo {
		width: min(460px, 58vw);
		height: auto;
		margin: 0 auto clamp(14px, 2.2vh, 24px);
		display: block;
		filter: drop-shadow(0 0 16px rgba(255, 0, 56, 0.78));
	}

	h1 {
		margin: 0 auto;
		max-width: 1180px;
		font-size: clamp(1.8rem, 3.35vw, 3.25rem);
		font-weight: 400;
		line-height: 1.12;
		text-shadow: 0 4px 18px rgba(0, 0, 0, 0.9), 0 0 12px rgba(255, 255, 255, 0.24);
	}

	.feature-actions {
		display: flex;
		flex-wrap: nowrap;
		justify-content: center;
		gap: 10px;
		margin: 0 auto clamp(10px, 1.5vh, 16px);
	}

	.feature-button {
		flex: 1 1 0;
		max-width: 150px;
		min-width: 112px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 8px 22px;
		border: 1px solid rgba(255, 244, 239, 0.72);
		background: linear-gradient(180deg, rgba(104, 0, 18, 0.72), rgba(10, 0, 2, 0.88));
		color: var(--paper);
		font: inherit;
		font-size: clamp(0.82rem, 1.1vw, 1rem);
		cursor: pointer;
		text-decoration: none;
		white-space: nowrap;
		box-shadow: inset 0 0 12px rgba(255, 0, 45, 0.24), 0 0 10px rgba(255, 0, 45, 0.2);
		transition: border-color 0.18s ease, box-shadow 0.18s ease;
	}

	.feature-button:hover,
	.feature-button:focus-visible {
		border-color: #fff;
		box-shadow: inset 0 0 16px rgba(255, 0, 45, 0.38), 0 0 14px rgba(255, 0, 45, 0.42);
	}

	.lead {
		max-width: 980px;
		margin: clamp(12px, 1.8vh, 18px) auto 0;
		color: var(--muted);
		font-size: clamp(0.98rem, 1.45vw, 1.28rem);
		line-height: 1.55;
		text-shadow: 0 2px 10px #000;
	}

	.update-notes {
		max-width: 980px;
		margin: clamp(12px, 1.8vh, 18px) auto 0;
		color: rgba(255, 244, 239, 0.88);
		text-align: left;
	}

	.update-notes h2 {
		margin: 0 0 6px;
		color: var(--paper);
		font-size: clamp(0.9rem, 1.2vw, 1.08rem);
		font-weight: 700;
	}

	.update-notes ul {
		margin: 0;
		padding-left: 1.25rem;
		font-size: clamp(0.78rem, 1vw, 0.95rem);
		line-height: 1.45;
	}

	.screenshot-carousel {
		width: min(1100px, 100%);
		margin: clamp(18px, 3vh, 30px) auto 0;
		position: relative;
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.carousel-viewport {
		width: 100%;
		overflow: hidden;
	}

	.carousel-track {
		display: flex;
		gap: clamp(12px, 2vw, 24px);
		transition: transform 0.38s ease;
		will-change: transform;
	}

	.shot-card {
		display: block;
		overflow: hidden;
		background: #050505;
		border: 1px solid rgba(255, 244, 239, 0.78);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.58);
		transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
		padding: 0;
		cursor: zoom-in;
	}

	.shot-card {
		flex: 0 0 calc((100% - clamp(12px, 2vw, 24px) * 2) / 3);
		aspect-ratio: 20 / 9;
	}

	.carousel-control {
		width: 38px;
		height: 86px;
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		border: 1px solid rgba(255, 0, 40, 0.62);
		background: rgba(0, 0, 0, 0.46);
		color: rgba(255, 255, 255, 0.9);
		font-family: Georgia, serif;
		font-size: 3.2rem;
		line-height: 1;
		cursor: pointer;
		box-shadow: inset 0 0 14px rgba(255, 0, 35, 0.26), 0 0 10px rgba(255, 0, 35, 0.35);
		transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
	}

	.carousel-control:hover {
		color: #fff;
		border-color: #fff;
		transform: scale(1.04);
	}

	.carousel-dots {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-top: clamp(8px, 1.3vh, 12px);
	}

	.carousel-dots button {
		width: 34px;
		height: 3px;
		padding: 0;
		border: 0;
		background: rgba(255, 244, 239, 0.34);
		cursor: pointer;
		box-shadow: 0 0 8px transparent;
	}

	.carousel-dots button.active {
		background: #fff;
		box-shadow: 0 0 10px rgba(255, 0, 35, 0.9);
	}

	.shot-card:hover {
		border-color: var(--ember);
		box-shadow: 0 0 12px rgba(255, 0, 45, 0.5), 0 12px 30px rgba(0, 0, 0, 0.58);
	}

	.shot-card img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 48px 72px;
		background: rgba(0, 0, 0, 0.86);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.18s ease;
	}

	.lightbox.active {
		opacity: 1;
		pointer-events: auto;
	}

	.lightbox-image {
		max-width: min(1200px, 90vw);
		max-height: 82vh;
		display: block;
		border: 1px solid rgba(255, 244, 239, 0.86);
		box-shadow: 0 0 30px rgba(255, 0, 50, 0.3), 0 20px 60px rgba(0, 0, 0, 0.8);
		object-fit: contain;
	}

	.lightbox-close,
	.lightbox-nav {
		position: absolute;
		border: 1px solid rgba(255, 0, 40, 0.72);
		background: rgba(0, 0, 0, 0.6);
		color: #fff;
		cursor: pointer;
		box-shadow: inset 0 0 14px rgba(255, 0, 35, 0.24), 0 0 12px rgba(255, 0, 35, 0.35);
	}

	.lightbox-close {
		top: 22px;
		right: 24px;
		width: 42px;
		height: 42px;
		font-size: 2rem;
		line-height: 1;
	}

	.lightbox-nav {
		top: 50%;
		width: 48px;
		height: 76px;
		transform: translateY(-50%);
		font-family: Georgia, serif;
		font-size: 3.2rem;
		line-height: 1;
	}

	.lightbox-prev {
		left: 24px;
	}

	.lightbox-next {
		right: 24px;
	}

	.story-modal {
		position: fixed;
		inset: 0;
		z-index: 110;
		display: grid;
		place-items: center;
		padding: clamp(16px, 4vw, 48px);
		background: rgba(0, 0, 0, 0.88);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.story-modal.active {
		opacity: 1;
		pointer-events: auto;
	}

	.story-dialog {
		width: min(880px, 94vw);
		max-height: min(86vh, 920px);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background:
			linear-gradient(rgba(7, 0, 2, 0.94), rgba(0, 0, 0, 0.97)),
			url('/scaresoul/scaresoul_bg.png') center / cover;
		border: 1px solid rgba(255, 244, 239, 0.72);
		box-shadow: 0 0 28px rgba(255, 0, 45, 0.32), 0 24px 80px rgba(0, 0, 0, 0.9);
	}

	.story-dialog-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 16px 12px 22px;
		border-bottom: 1px solid rgba(255, 0, 45, 0.38);
		background: rgba(55, 0, 10, 0.54);
	}

	.story-dialog-header h2 {
		margin: 0;
		font-size: clamp(1.1rem, 2vw, 1.45rem);
		font-weight: 500;
	}

	.story-close {
		width: 38px;
		height: 38px;
		border: 1px solid rgba(255, 244, 239, 0.62);
		background: rgba(0, 0, 0, 0.58);
		color: #fff;
		font-size: 1.8rem;
		line-height: 1;
		cursor: pointer;
	}

	.story-content {
		overflow-y: auto;
		padding: clamp(22px, 4vw, 42px);
		color: rgba(255, 244, 239, 0.9);
		font-size: clamp(0.92rem, 1.25vw, 1.08rem);
		line-height: 1.9;
		text-align: left;
	}

	.story-content :global(h1) {
		margin: 0 0 1.4em;
		font-size: clamp(1.55rem, 3vw, 2.25rem);
		text-align: center;
	}

	.story-content :global(h2) {
		margin: 2em 0 0.75em;
		color: #fff;
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		font-weight: 500;
	}

	.story-content :global(p) {
		margin: 0 0 1.1em;
	}

	.story-content :global(strong) {
		color: #fff;
		text-shadow: 0 0 8px rgba(255, 0, 45, 0.48);
	}

	.story-content :global(hr) {
		margin: 2em 0;
		border: 0;
		border-top: 1px solid rgba(255, 0, 45, 0.38);
	}

	.catalog-dialog {
		width: min(1040px, 96vw);
	}

	.catalog-content {
		overflow-x: auto;
	}

	.catalog-content :global(h2) {
		margin-top: 0;
	}

	.catalog-content :global(h3) {
		margin: 1.8em 0 0.65em;
		color: #fff;
		font-size: clamp(1rem, 1.7vw, 1.25rem);
		font-weight: 500;
	}

	.catalog-content :global(table) {
		width: 100%;
		min-width: 560px;
		margin: 0 0 1.6em;
		border-collapse: collapse;
		background: rgba(0, 0, 0, 0.34);
		font-size: 0.92em;
	}

	.catalog-content :global(th),
	.catalog-content :global(td) {
		padding: 9px 12px;
