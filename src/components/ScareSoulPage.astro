</style>

<script>
	function initScareSoulCarousel() {
		const track = document.querySelector('.carousel-track');
		const cards = Array.from(document.querySelectorAll('.shot-card'));
		const prev = document.querySelector('.carousel-control.prev');
		const next = document.querySelector('.carousel-control.next');
		const dots = Array.from(document.querySelectorAll('.carousel-dots button'));
		if (!track || cards.length === 0 || !prev || !next) return;

		let index = 0;
		let timer;

		function visibleCount() {
			return window.matchMedia('(max-width: 820px)').matches ? 1 : 3;
		}

		function maxIndex() {
			return Math.max(0, cards.length - visibleCount());
		}

		function update() {
			index = Math.max(0, Math.min(index, maxIndex()));
			const firstCard = cards[0];
			const gap = parseFloat(getComputedStyle(track).columnGap || '0');
			const offset = index * (firstCard.getBoundingClientRect().width + gap);
			track.style.transform = `translateX(-${offset}px)`;
			dots.forEach((dot, dotIndex) => dot.classList.toggle('active', dotIndex === index));
		}

		function go(nextIndex) {
			index = nextIndex > maxIndex() ? 0 : nextIndex < 0 ? maxIndex() : nextIndex;
			update();
		}

		function restartAutoPlay() {
			window.clearInterval(timer);
			timer = window.setInterval(() => go(index + 1), 4200);
		}

		prev.addEventListener('click', () => {
			go(index - 1);
			restartAutoPlay();
		});

		next.addEventListener('click', () => {
			go(index + 1);
			restartAutoPlay();
		});

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				go(Number(dot.getAttribute('data-slide') || 0));
				restartAutoPlay();
			});
		});

		window.addEventListener('resize', update);
		update();
		restartAutoPlay();
	}

	initScareSoulCarousel();
	document.addEventListener('astro:page-load', initScareSoulCarousel);

	function initScareSoulLightbox() {
		const lightbox = document.querySelector('.lightbox');
		const image = document.querySelector('.lightbox-image') as HTMLImageElement | null;
		const closeBtn = document.querySelector('.lightbox-close');
		const prevBtn = document.querySelector('.lightbox-prev');
		const nextBtn = document.querySelector('.lightbox-next');
		const shots = Array.from(document.querySelectorAll('.shot-card')) as HTMLElement[];
		if (!lightbox || !image || !closeBtn || !prevBtn || !nextBtn || shots.length === 0) return;

		let activeIndex = 0;

		function open(index: number) {
			activeIndex = index;
			const src = shots[activeIndex]?.dataset.fullSrc;
			if (!src) return;
			image.src = src;
			lightbox.classList.add('active');
			lightbox.setAttribute('aria-hidden', 'false');
		}

		function close() {
			lightbox.classList.remove('active');
			lightbox.setAttribute('aria-hidden', 'true');
			image.src = '';
		}

		function show(offset: number) {
			activeIndex = (activeIndex + offset + shots.length) % shots.length;
			const src = shots[activeIndex]?.dataset.fullSrc;
			if (src) image.src = src;
		}

		shots.forEach((shot, index) => {
			if (shot.dataset.lightboxInit) return;
			shot.dataset.lightboxInit = 'true';
			shot.addEventListener('click', () => open(index));
		});

		if (!(closeBtn as HTMLElement).dataset.lightboxInit) {
			(closeBtn as HTMLElement).dataset.lightboxInit = 'true';
			closeBtn.addEventListener('click', close);
			lightbox.addEventListener('click', (event) => {
				if (event.target === lightbox) close();
			});
			prevBtn.addEventListener('click', () => show(-1));
			nextBtn.addEventListener('click', () => show(1));
			document.addEventListener('keydown', (event) => {
				if (!lightbox.classList.contains('active')) return;
				if (event.key === 'Escape') close();
				if (event.key === 'ArrowLeft') show(-1);
				if (event.key === 'ArrowRight') show(1);
			});
		}
	}

	initScareSoulLightbox();
	document.addEventListener('astro:page-load', initScareSoulLightbox);

	function initScareSoulContentModals() {
		const openButtons = Array.from(document.querySelectorAll('.content-open')) as HTMLElement[];
		if (openButtons.length === 0) return;

		openButtons.forEach((openButton) => {
			if (openButton.dataset.modalInit) return;
			const targetId = openButton.dataset.modalTarget;
			const modal = targetId ? document.getElementById(targetId) : null;
			const closeButton = modal?.querySelector('.story-close') as HTMLElement | null;
			if (!modal || !closeButton) return;

			let previousFocus: HTMLElement | null = null;

			function open() {
				previousFocus = document.activeElement as HTMLElement | null;
				modal.classList.add('active');
				modal.setAttribute('aria-hidden', 'false');
				closeButton.focus();
			}

			function close() {
				modal.classList.remove('active');
				modal.setAttribute('aria-hidden', 'true');
				previousFocus?.focus();
			}

			openButton.dataset.modalInit = 'true';
			openButton.addEventListener('click', open);
			closeButton.addEventListener('click', close);
			modal.addEventListener('click', (event) => {
				if (event.target === modal) close();
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && modal.classList.contains('active')) close();
			});
		});
	}

	initScareSoulContentModals();
	document.addEventListener('astro:page-load', initScareSoulContentModals);

	function initScareSoulDownloadTracking() {
		document.querySelectorAll('.scaresoul-download-track').forEach(link => {
			if ((link as HTMLElement).dataset.tracked) return;
			(link as HTMLElement).dataset.tracked = 'true';
			link.addEventListener('click', () => {
				// @ts-ignore
				if (typeof gtag === 'function') {
					// @ts-ignore
					gtag('event', 'download', {
						event_category: 'apk',
						event_label: 'scaresoul_offline_v1.5.1c',
						file_name: 'scaresoul_offline.apk',
						game: 'scaresoul',
					});
				}
			});
		});
	}

	initScareSoulDownloadTracking();
	document.addEventListener('astro:page-load', initScareSoulDownloadTracking);
</script>
