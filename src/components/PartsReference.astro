---
import originalParts from '../data/da01-parts.json';
import modules from '../data/da01-handcraft.json';
const {lang='zh',handcraft=false}=Astro.props;
const parts=handcraft?modules:originalParts;
const c={zh:{title:'DA-01 分件参考',intro:'旋转查看，拆解部件。',all:'整机',part:'部件',explode:'拆解距离',isolate:'只看选中部件',wire:'线框',reset:'重置视角',front:'正面',back:'背面',left:'左侧',right:'右侧',download:'下载全部白模',stl:'下载此部件 STL',size:'外形尺寸',unit:'毫米',note:'外形参考白模，尚未添加实物关节与壁厚。',views:'视图参考',overview:'部件对照图',loading:'正在加载…',error:'无法加载 3D，请刷新重试或查看下方参考图。',ready:'拖动旋转 · 双指缩放 · 点击选择部件',open:'选中部件有开口或非流形边，打印前需修补。',catalog:'机甲工坊'},en:{title:'DA-01 Parts Reference',intro:'Rotate, inspect, and separate parts.',all:'Full mech',part:'Part',explode:'Explode',isolate:'Isolate selected part',wire:'Wireframe',reset:'Reset view',front:'Front',back:'Back',left:'Left',right:'Right',download:'Download all parts',stl:'Download part STL',size:'Dimensions',unit:'mm',note:'Surface reference; physical joints and wall thickness are not added.',views:'Reference views',overview:'Parts index',loading:'Loading…',error:'3D could not load. Reload or use the reference images below.',ready:'Drag to rotate · Pinch to zoom · Tap a part to select',open:'This part has open or non-manifold edges. Repair before printing.',catalog:'Mecha Workshop'},ja:{title:'DA-01 パーツ資料',intro:'回転・分解してパーツを確認。',all:'機体全体',part:'パーツ',explode:'分解距離',isolate:'選択パーツのみ',wire:'ワイヤーフレーム',reset:'視点をリセット',front:'正面',back:'背面',left:'左側',right:'右側',download:'全パーツをダウンロード',stl:'パーツ STL',size:'外形寸法',unit:'mm',note:'外形参考モデルです。可動関節と肉厚は未設計です。',views:'参考図',overview:'パーツ一覧図',loading:'読み込み中…',error:'3Dを読み込めません。再読み込みするか下の参考図をご覧ください。',ready:'ドラッグで回転 · ピンチで拡縮 · タップで選択',open:'開いた辺または非多様体の辺があります。印刷前に修復してください。',catalog:'機体工房'}}[lang];
if(handcraft) Object.assign(c,{title:lang==='zh'?'DA-01 手工制作参考':lang==='ja'?'DA-01 手作り資料':'DA-01 Handcraft Reference',intro:lang==='zh'?'先做一条腿，再搭骨架与外甲。':lang==='ja'?'片脚から始め、骨格と外装を組み立てる。':'Start with one leg, then build the frame and armor.',catalog:lang==='zh'?'原始分件':lang==='ja'?'元のパーツ':'Original parts',note:lang==='zh'?'模块仅作外形分组，连接结构待试制。':lang==='ja'?'外形のグループです。接続構造は試作が必要です。':'Shape groups only; connections need prototyping.'});
const label=(p:typeof parts[number])=>lang==='zh'?p.zh:lang==='ja'?p.original_name.replace('☆',''):p.en;
---
<main class="parts-reference" data-parts-reference data-handcraft={handcraft?'true':undefined} data-parts={JSON.stringify(parts.map(p=>({...p,paths:undefined})))} data-copy={JSON.stringify(c)}>
 <header><div><h1>{c.title}</h1><p>{c.intro}</p></div><a href={lang==='en'?(handcraft?'/parts-reference':'/workshop'):`/${lang}/${handcraft?'parts-reference':'workshop'}`}>{c.catalog}</a></header>
 {handcraft && <div class="craft-toolbar"><label for="craft-height">{lang==='zh'?'成品高度':lang==='ja'?'完成高さ':'Overall height'}<select id="craft-height" data-height><option value="120">120 mm</option><option value="150">150 mm</option><option value="180" selected>180 mm</option></select></label><button type="button" data-leg>{lang==='zh'?'先看左腿':lang==='ja'?'左脚を見る':'Inspect left leg'}</button><button type="button" data-whole>{lang==='zh'?'整机':lang==='ja'?'全体':'Full mech'}</button><span>{lang==='zh'?'按当前姿态最高点计算':lang==='ja'?'現在のポーズの最高点を基準':'Measured to the highest point in this pose'}</span></div>}
 {!handcraft && <a class="craft-entry" href={lang==='en'?'/handcraft':`/${lang}/handcraft`}>{lang==='zh'?'手工制作参考':lang==='ja'?'手作り資料':'Handcraft reference'}</a>}
 <div class="reference-layout">
  <section class="stage" aria-label={c.title}>
   <div class="canvas" data-canvas tabindex="0" role="img" aria-label={c.ready}></div>
   <div class="view-tools">{(['front','back','left','right'] as const).map(v=><button data-view={v} type="button" disabled>{c[v]}</button>)}<button data-reset type="button" disabled>{c.reset}</button></div>
   <p class="status" data-status role="status">{c.loading}</p>
  </section>
  <aside>
   <fieldset disabled data-editor>
    <label class="picker" for="reference-part">{c.part}<select id="reference-part" data-part><option value="">{c.all}</option>{parts.map((p,index)=><option value={p.file}>{handcraft?String(index+1).padStart(2,'0'):p.file.slice(0,2)} · {label(p)}</option>)}</select></label>
    <label class="range" for="reference-explode"><span>{c.explode}<output data-distance>0%</output></span><input id="reference-explode" type="range" min="0" max="100" value="0" data-explode/></label>
    <label class="check"><input type="checkbox" data-isolate/>{c.isolate}</label>
    <label class="check"><input type="checkbox" data-wire/>{c.wire}</label>
   </fieldset>
   <section class="part-info" aria-live="polite"><h2 data-name>{c.all}</h2><p>{c.size} <strong data-size>—</strong> {c.unit}</p><p class="mesh-note" data-mesh-note hidden>{c.open}</p><a data-stl hidden>{c.stl}</a></section>
   {!handcraft && <a class="download" href="/reference/da01/DA01_parts.zip" download>{c.download}</a>}
   <p class="note">{!handcraft && '120 mm · '}{c.note}</p>
  </aside>
 </div>
 {!handcraft && <section class="references"><h2>{c.views}</h2><div class="views">{(['front','back','left','right'] as const).map(v=><a href={`/reference/da01/${v}.png`} target="_blank" rel="noopener"><img src={`/reference/da01/${v}.png`} alt={`DA-01 ${c[v]}`} loading="lazy" width="1000" height="1100"/><span>{c[v]}</span></a>)}</div><a class="overview" href="/reference/da01/parts_overview.png" target="_blank" rel="noopener">{c.overview}</a></section>}
 <slot />
</main>
<script>import '../scripts/parts-reference';</script>
<style>
.craft-entry{display:inline-block;padding:0 0 20px}.craft-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:0 0 18px;padding:16px;background:#09222bea}.craft-toolbar label{display:flex;align-items:center;gap:12px;font-size:13px}.craft-toolbar select{width:auto}.craft-toolbar button{min-height:44px;border:1px solid #37626d;background:#153942;color:#d4f5f7;padding:8px 16px;cursor:pointer;font:inherit;font-size:13px}.craft-toolbar span{font-size:12px;color:#88aab2}.parts-reference{max-width:1280px;margin:auto;padding:32px 24px 64px;color:#d8ebee;font-family:system-ui,sans-serif}.parts-reference header{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:22px}h1{font-weight:550;font-size:clamp(24px,4vw,36px);margin:0 0 8px}header p{margin:0;color:#91b4bb;font-size:14px}.parts-reference a{color:#7ee4eb;text-decoration:none}.parts-reference a:hover{text-decoration:underline}.reference-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:20px}.stage{height:min(72vh,760px);min-height:470px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 40%,#193b42,#071219)}.canvas{position:absolute;inset:0;touch-action:none}.canvas :global(canvas){display:block;touch-action:none;width:100%;height:100%}.view-tools{position:absolute;top:12px;left:12px;right:12px;display:flex;flex-wrap:wrap;gap:6px;pointer-events:none}.view-tools button{pointer-events:auto;background:#09252dea;border:1px solid #335660;color:#c9e9ee;padding:10px 12px;min-height:44px;cursor:pointer;font:12px system-ui}.status{position:absolute;bottom:12px;left:16px;right:16px;margin:0;font-size:12px;color:#9ebdc4;pointer-events:none}.parts-reference aside{background:#07191ff5;padding:22px;align-self:start}fieldset{border:0;padding:0;margin:0;min-width:0}.picker{display:grid;gap:10px;font-size:13px;color:#a7c9ce}select{width:100%;min-height:44px;background:#102b34;color:#def6f7;border:1px solid #38616b;padding:8px;font:inherit}.range{display:block;margin:24px 0 14px;font-size:13px}.range span{display:flex;justify-content:space-between}output{font:12px monospace;color:#7ee4eb}input[type=range]{appearance:none;width:100%;height:36px;background:transparent;cursor:ew-resize;margin:6px 0 0}input[type=range]::-webkit-slider-runnable-track{height:5px;background:#2a5461}input[type=range]::-moz-range-track{height:5px;background:#2a5461}input[type=range]::-webkit-slider-thumb{appearance:none;width:14px;height:20px;margin-top:-7px;background:#79e2e8;border:1px solid #d2ffff;border-radius:2px}input[type=range]::-moz-range-thumb{width:14px;height:20px;background:#79e2e8;border:1px solid #d2ffff;border-radius:2px}.check{display:flex;align-items:center;gap:10px;min-height:44px;font-size:13px;cursor:pointer}.check input{accent-color:#58d5dc;width:18px;height:18px}.part-info{margin-top:18px;padding-top:18px;border-top:1px solid #24454e}.part-info h2{font-size:16px;margin:0 0 10px}.part-info p{font-size:12px;line-height:1.6;color:#9ebcc4}.part-info strong{font-weight:500;color:#d4eff2}.mesh-note{color:#d7bd8f!important}.part-info a{display:block;padding:10px 0;font-size:13px}.download{display:block;background:#72d9dd;color:#09212a!important;text-align:center;padding:13px 12px;margin-top:22px;font-size:14px;font-weight:600}.note{font-size:12px;color:#8faeb6;line-height:1.7}.references{margin-top:36px}.references h2{font-size:19px;font-weight:500}.views{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.views a{background:#0c222bec;display:block}.views img{display:block;width:100%;height:auto}.views span{display:block;padding:12px;text-align:center;font-size:13px}.overview{display:inline-block;padding:16px 0;font-size:14px}.parts-reference [hidden]{display:none!important}button:disabled{opacity:.5;cursor:wait}button:focus-visible,select:focus-visible,input:focus-visible,a:focus-visible,.canvas:focus-visible{outline:2px solid #9affff;outline-offset:3px}
@media(max-width:800px){.parts-reference{padding:22px 16px 40px}.parts-reference header{align-items:flex-start}.parts-reference header>a{font-size:13px;white-space:nowrap;padding-top:8px}.reference-layout{grid-template-columns:1fr;gap:14px}.stage{height:52svh;min-height:320px;max-height:520px}.parts-reference aside{padding:20px}.views{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.view-tools{gap:4px}.view-tools button{padding:9px 10px}}
</style>
